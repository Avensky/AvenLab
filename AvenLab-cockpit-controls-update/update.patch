+          begin(e.pointerId, null, angle(e));
+          e.currentTarget.setPointerCapture?.(e.pointerId);
+        }}
+        onPointerMove={(e) => {
+          const held = press.current;
+          if (!held || held.id !== e.pointerId) return;
+          e.stopPropagation();
+          const delta = ((angle(e) - held.angle + 540) % 360) - 180;
+          if (Math.abs(delta) <= 10) return;
+          clearTimer();
+          held.dragged = true;
+          held.advanced = true;
+          const phase = Math.max(
+            0,
+            Math.min(3, held.initial + Math.round(delta / 45)),
+          );
+          if (phase !== held.phase) {
+            held.phase = phase;
+            setHeldPhase(phase);
+            send(phase);
+          }
+        }}
+        onPointerUp={(e) => finish(e)}
+        onPointerCancel={(e) => finish(e, true)}
+        onLostPointerCapture={(e) => finish(e, true)}
+        onBlur={release}
+        onKeyDown={(e) => {
+          if (e.key === " " || e.key === "Enter") {
+            e.preventDefault();
+            e.stopPropagation();
+            if (!e.repeat) begin(null, e.key);
+            return;
+          }
+          if (e.key === "End") {
+            e.preventDefault();
+            e.stopPropagation();
+            if (!e.repeat) {
+              begin(null, "End");
+              if (press.current) {
+                clearTimer();
+                press.current.phase = 3;
+                press.current.advanced = true;
+                setHeldPhase(3);
+                send(3);
+              }
+            }
+            return;
+          }
+          const dir =
+            e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
+          if (dir || ["Home", "End", "Delete"].includes(e.key)) {
+            e.preventDefault();
+            e.stopPropagation();
+            if (e.repeat) return;
+            if (e.key === "Delete") {
+              if (state.ignition === 0) {
+                release();
+                send(0, !state.keyInserted);
+              }
+            } else
+              choose(
+                e.key === "Home"
+                  ? 0
+                  : Math.max(0, Math.min(2, state.ignition + dir)),
+              );
+          }
+        }}
+        onKeyUp={(e) => {
+          if (![" ", "Enter", "End"].includes(e.key)) return;
+          e.preventDefault();
+          e.stopPropagation();
+          const held = press.current;
+          if (held?.key === e.key) {
+            const tap = !held.advanced;
+            release();
+            suppress.current = false;
+            if (tap) send(0);
+          }
+        }}
+      >
+        <IgnitionArtwork
+          gradient={gradient}
+          shown={shown}
+          holding={heldPhase !== null}
+          keyInserted={state.keyInserted}
+        />
+      </button>
+    </div>
+  );
 }
