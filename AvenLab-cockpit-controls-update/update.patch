-            ]
-            distinct_sessions = {str(row.get("session_id")) for row in matching}
-
-        minimum_sessions = 3 if baseline_only else 2
-        if len(distinct_sessions) < minimum_sessions:
-            continue
-
-        template = dict(max(
-            matching,
