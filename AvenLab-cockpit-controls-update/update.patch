-def has_opposing_action_markers(markers: list[dict[str, Any]]) -> bool:
-    polarities = {
-        polarity
-        for marker in markers
-        if (polarity := marker_polarity(marker)) is not None
-    }
-    return {"on", "off"}.issubset(polarities)
