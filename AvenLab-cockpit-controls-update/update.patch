-
-        frame_count = int(row.get("frame_count") or 0)     
-
-        marker_count = int(row.get("marker_count") or 0)
-        analyzed = bool(row.get("report_id")) or confidence is not None
-        capture_status = str(row.get("capture_status") or "open")
