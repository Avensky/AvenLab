+# Ignition artwork and ring geometry
+
+Public entry: `index.ts`. `../IgnitionSwitch.tsx` owns requests and gesture lifetime; `../starterRelayAudio.ts` owns one shared clicking-audio context.
+
+| Export | Editing responsibility |
+| --- | --- |
+| IgnitionArtwork | Non-interactive SVG: cylinder, labels, progress arc and key |
+| IGNITION_ANGLES / IGNITION_POSITIONS | OFF/ACC/ON/START detents and labels; not vehicle heading |
+| IGNITION_LABEL_RADIUS / IGNITION_RING_RADIUS | Label radius 54 and outer light radius 61 |
+| ignitionViewBox | Canvas bounds follow the outer ring with padding |
+| ignitionTravelPath | The held sweep follows the outer ring, outside all labels |
+
+To move the light farther outside the labels, change `IGNITION_RING_RADIUS`; the view box and travel path follow it. Appearance/flicker lives in `styles/ignition.css`. `heldPhase` is transient input; only confirmed Rust resource STARTING controls crank flicker and relay clicks. Released START springs to ON. Reduced motion uses steady light. Do not paint engine-running state from a click or add a second starter timer/network sender.
diff --git a/frontend/src/ui/Cockpit/ignition/geometry.ts b/frontend/src/ui/Cockpit/ignition/geometry.ts
new file mode 100644
index 0000000000000000000000000000000000000000..61eb0f1d3fe5b0037f1c4e753f58ebff7180d193
--- /dev/null
+++ b/frontend/src/ui/Cockpit/ignition/geometry.ts
@@ -0,0 +1,21 @@
+/** Key detents are independent from world/vehicle angles. SVG rotates around
+ * (60,60); labels sit at radius 54, the full light ring outside them at 61. */
+export const IGNITION_ANGLES = [-135, -90, -45, 0] as const;
+export const IGNITION_POSITIONS = ["OFF", "ACC", "ON", "START"] as const;
+export const IGNITION_LABEL_RADIUS = 54;
+export const IGNITION_RING_RADIUS = 61;
+
+/** The view box follows the outer light, so increasing its radius never clips
+ * the halo or moves OFF/ACC/ON/START to a different angular reference. */
+export function ignitionViewBox() {
+  const padding = IGNITION_RING_RADIUS + 3;
+  return `${60 - padding} ${60 - padding} ${padding * 2} ${padding * 2}`;
+}
+
+/** The held detent sweep follows the same outer ring instead of the old arc
+ * between the key cylinder and its labels. SVG pathLength normalizes it to 3. */
+export function ignitionTravelPath() {
+  const angle = (IGNITION_ANGLES[0] * Math.PI) / 180;
+  const radius = IGNITION_RING_RADIUS;
+  return `M${60 + radius * Math.cos(angle)} ${60 + radius * Math.sin(angle)}A${radius} ${radius} 0 0 1 ${60 + radius} 60`;
+}
