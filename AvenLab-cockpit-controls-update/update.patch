+
+/** Optional crystal readout. Plain detent buttons use the same cable requests;
+ * choosing a visual never changes the latch or the drift force. */
+export function ParkingDetents({
+  strength,
+  disabled,
+  onSelect,
+}: {
+  strength: number;
+  disabled: boolean;
+  onSelect: (level: number) => void;
+}) {
