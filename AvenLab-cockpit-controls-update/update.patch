+            </svg>
+          ) : (
+            <span className="parking-detent-value">{level}</span>
+          )}
+        </button>
+      ))}
+    </div>
+  );
+}
+
+/** Both artworks live in one input button. CSS picks a realistic stitched grip
+ * or a simple P switch; drag preview still uses the same optional handle ref. */
