+test("catalog reproduces measured GLB triangles, source hashes and complete corner groups", () => {
+  const catalog = JSON.parse(
+    fs.readFileSync(
+      new URL(
+        "../../avenlab-server/src/assets/roads/road-colliders.json",
+        import.meta.url,
+      ),
+      "utf8",
+    ),
+  );
+  assert.deepEqual(generateRoadCatalog(), catalog);
+  for (const asset of ROAD_ASSETS) {
+    const file = new URL("../public" + asset.lods[0].url, import.meta.url),
+      { bytes, raw } = readGlb(file);
+    assert.equal(
+      createHash("sha256").update(bytes).digest("hex"),
+      asset.lods[0].sha256,
+    );
+    const classified = new Map();
+    for (const part of raw) {
+      for (let i = 0; i < part.indices.length; i += 3) {
+        const vs = part.indices.slice(i, i + 3).map((index) => {
+          const [x, y, z] = part.positions
+            .slice(index * 3, index * 3 + 3)
+            .map((n, k) => n - asset.origin[k]);
+          return asset.id === "road_wide" ? [z, y, -x] : [x, y, z];
+        });
+        const role = roleAt(
+          part.material,
+          vs.reduce((n, v) => n + v[0], 0) / 3,
+          vs.reduce((n, v) => n + v[2], 0) / 3,
+          asset.id,
+        );
+        if (role === "markings" || role === "details") continue;
+        const [a, b, c] = vs,
+          u = b.map((n, k) => n - a[k]),
+          v = c.map((n, k) => n - a[k]);
+        if (
+          Math.hypot(
+            u[1] * v[2] - u[2] * v[1],
+            u[2] * v[0] - u[0] * v[2],
+            u[0] * v[1] - u[1] * v[0],
+          ) <= 1e-8
+        )
+          continue;
+        classified.set(role, (classified.get(role) ?? 0) + 1);
+      }
+    }
+    assert.deepEqual(
+      Object.fromEntries(classified),
+      Object.fromEntries(
+        asset.colliders.map((c) => [c.role, c.indices.length]),
+      ),
+    );
+    assert.ok(
+      asset.colliders.every((c) => !["markings", "details"].includes(c.role)),
+    );
+  }
+  assert.equal(
+    ROAD_ASSETS.find((a) => a.id === "intersection").colliders.length,
+    9,
+  );
 });
 
