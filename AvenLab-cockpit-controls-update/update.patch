@@ -0,0 +1,98 @@
+.controller-key,
+.layout-editor .controller-key {
+  display: inline-grid;
+  place-items: center;
+  flex: none;
+  min-width: 22px;
+  height: 21px;
+  padding: 1px 4px;
+  background: #090b0e !important;
+  color: #eceff3 !important;
+  border: 1px solid #8b929d !important;
+  border-radius: 4px !important;
+  font:
+    800 10px/1 ui-monospace,
+    monospace;
+  box-shadow: inset 0 -2px 0 #0008;
+  vertical-align: middle;
+}
+.controller-key:is(
+  [data-controller-key="A"],
+  [data-controller-key="B"],
+  [data-controller-key="X"],
+  [data-controller-key="Y"]
+) {
+  width: 21px;
+  min-width: 21px;
+  border-radius: 50% !important;
+}
+.controller-key[data-controller-key="A"] {
+  color: #62df82 !important;
+  border-color: #62df82 !important;
+}
+.controller-key[data-controller-key="B"] {
+  color: #ff626b !important;
+  border-color: #ff626b !important;
+}
+.controller-key[data-controller-key="X"] {
+  color: #75adff !important;
+  border-color: #75adff !important;
+}
+.controller-key[data-controller-key="Y"] {
+  color: #f4d45d !important;
+  border-color: #f4d45d !important;
+}
+.controller-shortcuts {
+  display: flex;
+  gap: 6px 14px;
+  flex-wrap: wrap;
+  align-items: center;
+  color: var(--app-muted, #a6b9d3);
+  font:
+    10px/1.3 system-ui,
+    sans-serif;
+}
+.controller-shortcuts > span {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+}
+.controller-shortcuts > span > kbd:not(.controller-key) {
+  font-size: 9px;
+  color: var(--app-muted, #a6b9d3);
+}
+@media (max-width: 600px) {
+  .controller-shortcuts {
+    gap: 4px 9px;
+    font-size: 9px;
+  }
+  .controller-key,
+  .layout-editor .controller-key {
+    min-width: 18px;
+    height: 18px;
+    font-size: 8px;
+  }
+  .controller-key:is(
+    [data-controller-key="A"],
+    [data-controller-key="B"],
+    [data-controller-key="X"],
+    [data-controller-key="Y"]
+  ) {
+    min-width: 18px;
+    width: 18px;
+  }
+}
+.controller-guide {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(215px, 1fr));
+  gap: 7px 14px;
+  color: var(--app-muted, #a6b9d3);
+  font:
+    11px/1.4 system-ui,
+    sans-serif;
+}
+.controller-guide > span {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+}
