+      doc?.base === "overlay" && source && focus !== "selected"
+        ? source.cell
+        : undefined,
+      focus === "selected",
+      focus === "selected" && selectedSpawn
+        ? doc?.spawns?.filter((p) => p.id === selectedSpawn)
