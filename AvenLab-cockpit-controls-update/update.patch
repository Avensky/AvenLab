+  return (
+    <svg
+      className="layout-plan"
+      aria-label="Map plan"
+      role="img"
+      viewBox={`${view.x} ${view.z} ${view.width} ${view.depth}`}
+      onContextMenu={(e) => e.preventDefault()}
+      onWheel={(e) => {
