+.hud-minimap {
+  position: absolute;
+  right: max(10px, env(safe-area-inset-right));
+  top: max(8px, env(safe-area-inset-top));
+  width: min(
+    calc(100dvw - 24px),
+    calc(100dvh - 24px),
+    max(
+      72px,
+      calc(
+        min(var(--console-width, 230px), clamp(112px, 21vw, 230px), 32dvh) *
+          var(--minimap-scale, 0.75)
+      )
+    )
+  );
+  aspect-ratio: 1;
+  pointer-events: auto;
+  color: #c5dee9;
+  font: 8px monospace;
+  z-index: 5;
+}
+.map-rim {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  z-index: 3;
+}
