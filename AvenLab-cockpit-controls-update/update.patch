-    training_metrics = _evaluate(model, flat_examples)
-    cross_validation = _cross_validate_grouped(
-        examples,
-        epochs=max(200, epochs // 2),
-        learning_rate=learning_rate,
-        l2=l2,
-    )
-    return model, training_metrics, cross_validation
