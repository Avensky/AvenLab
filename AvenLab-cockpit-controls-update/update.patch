+import type { CSSProperties } from "react";
+import { requestParkingStrength } from "./commands";
+import { HoldButton } from "../../../controls/TouchControls";
+import { useInputStore } from "../../../store/input/inputStore";
+import { useMomentaryFeedback } from "../useMomentaryFeedback";
+import { parkingLeverPose } from "./geometry";
+import { usePreferencesStore } from "../../../store/preferences/index";
+import { ParkingDetents, ParkingLeverArtwork } from "./ParkingArtwork";
+
+/** Driving pull: immediate rear brake while held, independent of the latched
+ * parking tension. Its own input source prevents touch release erasing keyboard
+ * or controller braking. Rust's existing handbrake/tire solver applies the force. */
+export function DriftBrakeLever({
+  strength,
+  disabled,
+  pending,
+}: {
+  strength: number;
+  disabled: boolean;
+  pending: boolean;
+}) {
+  const appearance = usePreferencesStore((s) => s.parkingBrakeStyle);
+  const contact = useMomentaryFeedback();
+  const pressure = useInputStore((s) => s.input.handbrake);
+  const pose = parkingLeverPose(Math.max(strength, pressure * 3));
+  const select = requestParkingStrength;
+  return (
+    <section
+      {...contact}
+      className="mechanical-handbrake drift-parking"
+      data-parking-style={appearance}
+      style={
+        {
+          "--parking-angle": `${pose.angle}deg`,
+          "--parking-reach": pose.reach,
+        } as CSSProperties
+      }
+    >
+      <ParkingDetents
+        strength={strength}
+        disabled={disabled}
+        onSelect={select}
+      />
+      <HoldButton
+        className="handbrake-lever"
+        disabled={disabled}
+        aria-label="Parking brake"
+        aria-busy={pending}
+        aria-pressed={pressure > 0 || strength > 0}
+        aria-description="Hold to pull the rear brake immediately for drifting; release to let go. Side detents set a parking latch."
+        title="Hold to drift; release to let go"
+        onHold={(held) =>
+          useInputStore
+            .getState()
+            .setAnalogFromSource("touch-parking", { handbrake: Number(held) })
+        }
+      >
+        <ParkingLeverArtwork />
+        <span className="parking-pull-label">PULL</span>
+      </HoldButton>
+      <button
+        className="parking-release"
+        type="button"
+        aria-label="Release parked brake"
+        title="Release parking latch"
+        disabled={disabled || strength === 0}
+        onClick={() => select(0)}
+      >
+        0
+      </button>
+    </section>
+  );
+}
diff --git a/frontend/src/ui/Cockpit/mechanical/GearSelector.tsx b/frontend/src/ui/Cockpit/mechanical/GearSelector.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a7fbe48e5cc68b69a2b0ee15e26d54328a45fca0
--- /dev/null
+++ b/frontend/src/ui/Cockpit/mechanical/GearSelector.tsx
@@ -0,0 +1,206 @@
+/** H/automatic selector visuals and drag intent. Rust chooses/gates actual gears;
+ * slot geometry and routed knob motion live in geometry.ts. */
+import { useEffect, useRef, type PointerEvent } from "react";
+import { selectDriveGear } from "../../../controls/drivetrainActions";
+import { usePreferencesStore } from "../../../store/preferences/preferencesStore";
+import { inNeutralLane, shiftKnobRoute } from "./geometry";
+import { useMomentaryFeedback } from "../useMomentaryFeedback";
+
+const manual = [
+  { gear: 7, label: "R", x: 12, y: 25 },
+  { gear: 1, label: "1", x: 36, y: 25 },
+  { gear: 3, label: "3", x: 61, y: 25 },
+  { gear: 5, label: "5", x: 86, y: 25 },
+  { gear: 0, label: "N", x: 61, y: 51 },
+  { gear: 2, label: "2", x: 36, y: 78 },
+  { gear: 4, label: "4", x: 61, y: 78 },
+  { gear: 6, label: "6", x: 86, y: 78 },
+];
+const automaticSlots = [
+  { gear: 8, label: "P", x: 50, y: 17 },
+  { gear: 7, label: "R", x: 50, y: 39 },
+  { gear: 0, label: "N", x: 50, y: 61 },
+  { gear: 1, label: "D", x: 50, y: 83 },
+];
+
+export function GearSelector({
+  automatic,
+  gear,
+  disabled,
+  pending,
+}: {
+  automatic: boolean;
+  gear: number;
+  disabled: boolean;
+  pending: boolean;
+}) {
+  const contact = useMomentaryFeedback();
+  const reduced = usePreferencesStore((s) => s.reducedMotion);
+  const animation = useRef<Animation | null>(null);
+  const slots = automatic ? automaticSlots : manual;
+  const selection = automatic && gear > 0 && gear < 7 ? 1 : gear;
+  const position = slots.find((slot) => slot.gear === selection) ?? slots[0];
+  const gate = useRef<HTMLDivElement>(null),
+    knob = useRef<HTMLButtonElement>(null),
+    drag = useRef<{
+      id: number;
+      x: number;
+      y: number;
+      moved: boolean;
+      neutral: boolean;
+    } | null>(null);
+  const select = (next: number) => selectDriveGear(next);
+  const shown = useRef(position);
+  const reset = () => {
+    if (knob.current) {
+      knob.current.style.left = `${position.x}%`;
+      knob.current.style.top = `${position.y}%`;
+    }
+  };
+  useEffect(() => {
+    const node = knob.current;
+    if (!node || drag.current) return;
+    const from = shown.current;
+    animation.current?.cancel();
+    node.style.left = `${position.x}%`;
+    node.style.top = `${position.y}%`;
+    if (
+      !reduced &&
+      node.animate &&
+      (from.x !== position.x || from.y !== position.y)
+    ) {
+      const rect = gate.current!.getBoundingClientRect();
+      animation.current = node.animate(
+        shiftKnobRoute(from, position, automatic).map((point) => ({
+          transform: `translate(-50%, -50%) translate(${((point.x - position.x) * rect.width) / 100}px, ${((point.y - position.y) * rect.height) / 100}px)`,
+        })),
+        { duration: 260, easing: "ease-in-out" },
+      );
+    }
+    shown.current = position;
+    return () => animation.current?.cancel();
+  }, [position, automatic, reduced]);
+  const finish = (event: PointerEvent<HTMLButtonElement>, cancel = false) => {
+    const current = drag.current;
+    if (!current || current.id !== event.pointerId) return;
+    drag.current = null;
+    if (event.currentTarget.hasPointerCapture?.(event.pointerId))
+      event.currentTarget.releasePointerCapture(event.pointerId);
+    if (cancel || !current.moved) {
+      reset();
+      return;
+    }
+    const rect = gate.current!.getBoundingClientRect(),
+      x = ((event.clientX - rect.left) / rect.width) * 100,
+      y = ((event.clientY - rect.top) / rect.height) * 100;
+    const nearest = slots.reduce((best, slot) =>
+      (slot.x - x) ** 2 + (slot.y - y) ** 2 <
+      (best.x - x) ** 2 + (best.y - y) ** 2
+        ? slot
+        : best,
+    );
+    const next = !automatic && inNeutralLane(y) ? 0 : nearest.gear;
+    const target = slots.find((slot) => slot.gear === next)!;
+    shown.current = target;
+    if (knob.current) {
+      knob.current.style.left = `${target.x}%`;
+      knob.current.style.top = `${target.y}%`;
+    }
+    if (next !== 0 || !current.neutral) select(next);
+  };
+  return (
+    <section
+      {...contact}
+      className="mechanical-shifter"
+      aria-label="Gear selector"
+    >
+      <div
+        className="shift-gate"
+        ref={gate}
+        data-automatic={automatic}
+        aria-busy={pending}
+      >
+        <svg
+          viewBox="0 0 100 100"
+          preserveAspectRatio="none"
+          aria-hidden="true"
+        >
+          <path
+            vectorEffect="non-scaling-stroke"
+            d={
+              automatic
+                ? "M50 17V83"
+                : "M12 25V51H86M36 25V78M61 25V78M86 25V78"
+            }
+          />
+        </svg>
+        {slots.map((slot) => (
+          <button
+            className="shift-slot"
+            key={slot.gear}
+            disabled={disabled}
+            aria-label={`Select ${slot.label === "R" ? "reverse" : slot.label === "N" ? "neutral" : slot.label === "P" ? "park" : slot.label === "D" ? "drive" : `gear ${slot.label}`}`}
+            aria-current={selection === slot.gear ? "true" : undefined}
+            style={{ left: `${slot.x}%`, top: `${slot.y}%` }}
+            onClick={() => select(slot.gear)}
+          >
+            {slot.label}
+          </button>
+        ))}
+        <button
+          className="shift-knob"
+          ref={knob}
+          disabled={disabled}
+          tabIndex={-1}
+          aria-label="Drag gear stick"
+          title="Drag to a gear, or select its slot"
+          style={{ left: `${position.x}%`, top: `${position.y}%` }}
+          onPointerDown={(event) => {
+            if (event.button !== 0 || drag.current) return;
+            animation.current?.cancel();
+            drag.current = {
+              id: event.pointerId,
+              x: event.clientX,
+              y: event.clientY,
+              moved: false,
+              neutral: false,
+            };
+            event.currentTarget.setPointerCapture?.(event.pointerId);
+          }}
+          onPointerMove={(event) => {
+            const current = drag.current;
+            if (!current || current.id !== event.pointerId) return;
+            current.moved ||=
+              Math.hypot(event.clientX - current.x, event.clientY - current.y) >
+              5;
+            if (!current.moved) return;
+            const rect = gate.current!.getBoundingClientRect(),
+              y = ((event.clientY - rect.top) / rect.height) * 100;
+            if (!automatic && inNeutralLane(y)) {
+              if (!current.neutral) select(0);
+              current.neutral = true;
+            } else current.neutral = false;
+            event.currentTarget.style.left = `${Math.max(8, Math.min(90, ((event.clientX - rect.left) / rect.width) * 100))}%`;
+            event.currentTarget.style.top = `${Math.max(12, Math.min(88, ((event.clientY - rect.top) / rect.height) * 100))}%`;
+          }}
+          onPointerUp={(event) => finish(event)}
+          onPointerCancel={(event) => finish(event, true)}
+          onLostPointerCapture={(event) => finish(event, true)}
+        >
+          <span>
+            {automatic ? position.label : "R 1 3 5"}
+            <br />
+            {automatic ? "AUTO" : "  2 4 6"}
+          </span>
+        </button>
+      </div>
+      <small>
+        {pending
+          ? "SHIFT REQUESTED"
+          : automatic
+            ? "AUTOMATIC"
+            : "H-PATTERN · AUTO ASSIST"}
+      </small>
+    </section>
+  );
+}
