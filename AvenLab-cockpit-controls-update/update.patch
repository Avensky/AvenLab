+test("relay clicks share one scheduler and stop all voices on confirmed release", () => {
+  const timers = new Map(),
+    voices = [];
+  let next = 0,
+    closed = false;
+  const parameter = { setValueAtTime() {}, exponentialRampToValueAtTime() {} };
+  const context = {
+    state: "running",
+    currentTime: 4,
+    destination: {},
+    createOscillator() {
+      const voice = {
+        frequency: parameter,
+        stops: 0,
+        connect(node) {
+          return node;
+        },
+        start() {},
+        stop() {
+          this.stops++;
+        },
+        disconnect() {},
+      };
+      voices.push(voice);
+      return voice;
+    },
+    createGain() {
+      return {
+        gain: parameter,
+        connect() {
+          return this;
+        },
+        disconnect() {},
+      };
+    },
+    close() {
+      closed = true;
+      return Promise.resolve();
+    },
+  };
+  const audio = createStarterRelayAudio(
+    () => context,
+    (callback) => {
+      timers.set(++next, callback);
+      return next;
+    },
+    (id) => timers.delete(id),
+  );
+  const a = Symbol(),
+    b = Symbol();
+  audio.unlock();
+  assert.equal(timers.size, 0, "unlocking alone cannot invent cranking");
+  audio.setCranking(a, true);
+  audio.setCranking(b, true);
+  assert.equal(timers.size, 1);
+  assert.equal(voices.length, 1);
+  [...timers.values()][0]();
+  assert.equal(voices.length, 2);
+  audio.setCranking(a, false);
+  assert.equal(timers.size, 1);
+  audio.setCranking(b, false);
+  assert.equal(timers.size, 0);
+  assert.ok(voices.every((v) => v.stops >= 2));
+  audio.dispose();
+  assert.equal(closed, true);
+});
