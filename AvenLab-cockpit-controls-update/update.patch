+    hasDestination = useNavigationStore((s) => s.destination !== null),
+    sandbox = useUIStore((s) => s.screen === "sandbox");
+  const title = mission?.title ?? (sandbox ? "SANDBOX" : "NAVIGATION"),
+    objective =
+      mission?.objective ??
+      (hasDestination ? "REACH GPS DESTINATION" : "FREE DRIVE");
