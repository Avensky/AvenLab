+              </button>
+            </div>
+          </section>
+        </div>
+      )}
+    </section>
+  );
+}
+export function WorldBuilderPanel({
+  planOnly = false,
+  modelReference = true,
+}: {
+  planOnly?: boolean;
+  modelReference?: boolean;
