+
+function NumberField({
+  label,
+  value,
+  step,
+  onCommit,
+}: {
+  label: string;
+  value: number;
+  step: number;
+  onCommit: (v: number) => boolean;
+}) {
+  const ref = useRef<HTMLInputElement>(null);
+  useEffect(() => {
+    if (ref.current && document.activeElement !== ref.current)
+      ref.current.value = String(Number(value.toFixed(6)));
+  }, [value]);
+  return (
+    <label>
+      {label}
+      <input
+        ref={ref}
+        type="number"
+        aria-label={label}
+        defaultValue={Number(value.toFixed(6))}
+        step={step}
+        onBlur={(e) => {
+          const v = Number(e.currentTarget.value);
+          if (
+            e.currentTarget.value !== "" &&
+            Number.isFinite(v) &&
+            v !== value
+          ) {
+            if (!onCommit(v))
+              e.currentTarget.value = String(Number(value.toFixed(6)));
+          } else e.currentTarget.value = String(Number(value.toFixed(6)));
+        }}
+        onKeyDown={(e) => {
+          if (e.key === "Enter") {
+            e.preventDefault();
+            e.stopPropagation();
+            e.currentTarget.blur();
+          } else if (e.key === "Escape") {
+            e.preventDefault();
+            e.stopPropagation();
+            e.currentTarget.value = String(value);
+            e.currentTarget.blur();
+          }
+        }}
+      />
+    </label>
+  );
+}
+export function CollisionBuilderPanel({
+  planOnly = false,
+}: {
+  planOnly?: boolean;
+}) {
+  const preferences = useEditorPreferences();
+  const state = useBuilderStore(),
+    root = useRef<HTMLElement>(null),
+    file = useRef<HTMLInputElement>(null),
+    importSequence = useRef(0);
+  const boxes = useMemo(
+      () => (state.doc ? editableBoxes(state.doc) : []),
+      [state.doc],
+    ),
+    box = boxes.find((b) => b.id === state.selected);
+  const run = useCallback((fn: () => void) => {
+    try {
+      fn();
+      return true;
+    } catch (error) {
+      useBuilderStore.setState({
+        status: error instanceof Error ? error.message : "Edit rejected",
+      });
+      return false;
+    }
+  }, []);
+  const navigate = useCallback((action: MenuAction) => {
+    if (action === "back") {
+      closeWorldBuilder();
+      return;
+    }
+    if (action === "previous_tab" || action === "next_tab") {
+      useBuilderStore.getState().cycle(action === "previous_tab" ? -1 : 1);
+      return;
+    }
+    const buttons = [
+        ...(root.current?.querySelectorAll<HTMLButtonElement>(
+          "button:not(:disabled)",
+        ) ?? []),
+      ],
+      current = buttons.indexOf(document.activeElement as HTMLButtonElement);
+    if (action === "activate") {
+      (buttons[current] ?? buttons[0])?.click();
+      return;
+    }
+    const delta = action === "up" || action === "left" ? -1 : 1;
+    buttons[(current + delta + buttons.length) % buttons.length]?.focus();
+  }, []);
+  useEffect(() => {
+    const sequence = importSequence;
+    const panel = (event: Event) =>
+      navigate((event as CustomEvent<MenuAction>).detail);
+    const shortcuts = (event: KeyboardEvent) => {
+      if (
+        (useUIStore.getState().overlay !== "world_builder" &&
+          useUIStore.getState().screen !== "world_builder") ||
+        isTypingTarget(event.target) ||
+        event.repeat
+      )
+        return;
+      if (
+        (event.ctrlKey || event.metaKey) &&
+        ["KeyZ", "KeyY"].includes(event.code)
+      ) {
+        event.preventDefault();
+        event.stopPropagation();
+        if (event.code === "KeyY" || event.shiftKey)
+          useBuilderStore.getState().redo();
+        else useBuilderStore.getState().undo();
+      } else if (event.code === "Delete") {
+        event.preventDefault();
+        event.stopPropagation();
+        useBuilderStore.getState().remove();
+      }
+    };
+    window.addEventListener("avenlab:panel-action", panel);
+    window.addEventListener("keydown", shortcuts, true);
+    return () => {
+      sequence.current++;
+      window.removeEventListener("avenlab:panel-action", panel);
+      window.removeEventListener("keydown", shortcuts, true);
+    };
+  }, [navigate]);
+  const importFile = async (selected: File) => {
+    const token = ++importSequence.current;
+    try {
+      if (selected.size > MAX_JSON_BYTES) throw Error("Map JSON exceeds 2 MiB");
+      const map = useWorldStore.getState().map,
+        target = useBuilderStore.getState().doc?.map_id,
+        doc = parseMapText(await selected.text(), target ?? map?.map_id);
+      if (
+        token !== importSequence.current ||
+        (useUIStore.getState().overlay !== "world_builder" &&
+          useUIStore.getState().screen !== "world_builder") ||
+        useBuilderStore.getState().doc?.map_id !== target ||
+        Boolean(useBuilderStore.getState().loadingMap)
+      )
+        return;
+      const current = useBuilderStore.getState();
+      if (current.doc) current.commit(doc);
+      else current.load(doc, "Imported map JSON");
+      useBuilderStore.setState({
+        source: `Imported JSON · ${map?.map_id === doc.map_id ? compareLiveTemplate(doc, map) : "World editor source"}`,
+        bounds: useBuilderStore.getState().bounds,
+        status:
+          "Imported draft · Undo is available. Server collisions are unchanged.",
+      });
+    } catch (error) {
+      if (token === importSequence.current)
+        useBuilderStore.setState({
+          status:
+            error instanceof Error ? error.message : "Could not import map",
+        });
+    }
+  };
+  const change = (group: "center" | "size", axis: number, value: number) =>
+    run(() => {
+      if (!box) return;
+      const center = [...box.center] as Triple,
+        half = [...box.half] as Triple;
+      if (group === "center") center[axis] = value;
+      else half[axis] = value / 2;
+      state.edit(center, half);
+    });
+  return (
+    <section
+      ref={root}
+      className={`world-builder ${state.view === "plan" ? "wb-plan-mode" : ""}`}
+      data-inspector={preferences.inspector}
+      aria-label="World builder"
+      onKeyDown={(e) => {
+        if (isTypingTarget(e.target)) return;
+        if (e.key === "Enter" || e.key === " ") {
+          e.stopPropagation();
+          return;
+        }
+        const action = (
+          {
+            ArrowUp: "up",
+            ArrowDown: "down",
+            ArrowLeft: "left",
+            ArrowRight: "right",
+            Escape: "back",
+          } as Record<string, MenuAction>
+        )[e.key];
+        if (action) {
+          e.preventDefault();
+          e.stopPropagation();
+          navigate(action);
+        }
+      }}
+    >
+      <header className="wb-header">
+        <strong>
+          WORLD BUILDER <small>COLLISION TEMPLATE</small>
+        </strong>
+        <EditorWorldControls compact />
+        <button
+          onClick={() => useBuilderStore.setState({ workspace: "layout" })}
+        >
+          LAYOUT EDITOR
+        </button>
+        <button
+          aria-controls="collision-inspector"
+          aria-expanded={preferences.inspector !== "hidden"}
+          onClick={() =>
+            preferences.setInspector(
+              preferences.inspector === "hidden" ? "open" : "hidden",
+            )
+          }
+        >
+          Inspector
+        </button>
+        <button onClick={closeWorldBuilder}>
+          <ControllerButton button="B" /> EXIT
+        </button>
+      </header>
+      <div className="wb-toolbar">
+        <button
+          disabled={planOnly || !state.doc}
+          title={
+            planOnly
+              ? "3D reference is available inside the running game"
+              : undefined
+          }
+          onClick={() =>
+            useBuilderStore.setState({
+              view: state.view === "plan" ? "3d" : "plan",
+            })
+          }
+        >
+          VIEW: {state.view.toUpperCase()}
+        </button>
+        <button
+          disabled={!state.doc}
+          onClick={() =>
+            useBuilderStore.setState({
+              tool: state.tool === "select" ? "move" : "select",
+            })
+          }
+        >
+          TOOL: {state.tool.toUpperCase()}
+        </button>
+        <button
+          onClick={() =>
+            useBuilderStore.setState({
+              snap: state.snap === 0.25 ? 0.5 : state.snap === 0.5 ? 1 : 0.25,
+            })
+          }
+        >
+          SNAP {state.snap} M
+        </button>
+        <button disabled={!state.doc} onClick={state.fit}>
+          FIT
+        </button>
+        {state.view === "3d" && (
+          <>
+            <button
+              onClick={() =>
+                useBuilderStore.setState({
+                  preset: state.preset === "iso" ? "top" : "iso",
+                })
+              }
+            >
+              {state.preset.toUpperCase()}
+            </button>
+            <button
+              aria-label="Zoom out"
+              onClick={() =>
+                useBuilderStore.setState({
+                  zoom: Math.min(4, state.zoom / 0.8),
+                })
+              }
+            >
+              −
+            </button>
+            <button
+              aria-label="Zoom in"
+              onClick={() =>
+                useBuilderStore.setState({
+                  zoom: Math.max(0.25, state.zoom * 0.8),
+                })
+              }
+            >
+              +
+            </button>
+          </>
+        )}
+        <button disabled={!state.past.length} onClick={state.undo}>
+          UNDO
+        </button>
+        <button disabled={!state.future.length} onClick={state.redo}>
+          REDO
+        </button>
+        <button disabled={!state.doc} onClick={state.save}>
+          SAVE
+        </button>
+        <button disabled={!state.doc} onClick={state.restore}>
+          LOAD
+        </button>
+        <button onClick={() => file.current?.click()}>IMPORT</button>
+        <button disabled={!state.doc} onClick={() => run(exportBuilderMap)}>
+          EXPORT JSON
+        </button>
+        <input
+          ref={file}
+          hidden
+          type="file"
+          accept="application/json,.json"
+          aria-label="Import server map JSON"
+          onChange={(e) => {
+            const selected = e.target.files?.[0];
+            e.target.value = "";
+            if (selected) void importFile(selected);
+          }}
+        />
+      </div>
+      <main className="wb-workspace">
+        <div className="wb-viewport">
+          {state.view === "plan" && <ColliderPlan />}
+          <span className="wb-view-note">
+            {state.view === "plan"
+              ? "X / Z PLAN · " +
+                (state.tool === "move" ? "DRAG A BOX" : "SELECT A FOOTPRINT")
+              : "3D REFERENCE · DRAG TO ORBIT · SCROLL / PINCH TO ZOOM"}
+          </span>
+        </div>
+        {preferences.inspector !== "hidden" && (
+          <aside id="collision-inspector" className="wb-inspector">
+            <div className="wb-selection-nav">
+              <button
+                aria-label="Previous collider"
+                disabled={!boxes.length}
+                onClick={() => state.cycle(-1)}
+              >
+                LB ‹
+              </button>
+              <strong>
+                {boxes.length
+                  ? `${boxes.findIndex((b) => b.id === state.selected) + 1} / ${boxes.length}`
+                  : "NO BOXES"}
+              </strong>
+              <button
+                aria-label="Next collider"
+                disabled={!boxes.length}
+                onClick={() => state.cycle(1)}
+              >
+                › RB
+              </button>
+            </div>
+            {box ? (
+              <>
+                <strong className="wb-object-name">{box.id}</strong>
+                <small>{box.collection.toUpperCase()} · AXIS-ALIGNED BOX</small>
+                <h2>POSITION · METRES · Y UP</h2>
+                <div className="wb-fields">
+                  {["X", "Y", "Z"].map((axis, i) => (
+                    <div key={axis}>
+                      <NumberField
+                        label={`Position ${axis}`}
+                        value={box.center[i]}
+                        step={state.snap}
+                        onCommit={(v) => change("center", i, v)}
+                      />
+                      <div>
+                        <button
+                          aria-label={`Decrease position ${axis}`}
+                          onClick={() =>
+                            change("center", i, box.center[i] - state.snap)
+                          }
+                        >
+                          −
+                        </button>
+                        <button
+                          aria-label={`Increase position ${axis}`}
+                          onClick={() =>
+                            change("center", i, box.center[i] + state.snap)
+                          }
+                        >
+                          +
+                        </button>
+                      </div>
+                    </div>
+                  ))}
+                </div>
+                <h2>FULL SIZE · WIDTH / HEIGHT / DEPTH</h2>
+                <div className="wb-fields">
+                  {["width", "height", "depth"].map((axis, i) => (
+                    <div key={axis}>
+                      <NumberField
+                        label={`Box ${axis}`}
+                        value={box.half[i] * 2}
+                        step={state.snap}
+                        onCommit={(v) => change("size", i, v)}
+                      />
+                      <div>
+                        <button
+                          aria-label={`Decrease ${axis}`}
+                          onClick={() =>
+                            change(
+                              "size",
+                              i,
+                              Math.max(0.02, box.half[i] * 2 - state.snap),
+                            )
+                          }
+                        >
+                          −
+                        </button>
+                        <button
+                          aria-label={`Increase ${axis}`}
+                          onClick={() =>
+                            change("size", i, box.half[i] * 2 + state.snap)
+                          }
+                        >
+                          +
+                        </button>
+                      </div>
+                    </div>
+                  ))}
+                </div>
+                <small>
+                  BOTTOM {(box.center[1] - box.half[1]).toFixed(3)} · TOP{" "}
+                  {(box.center[1] + box.half[1]).toFixed(3)}
+                </small>
+                <button onClick={state.remove}>DELETE SELECTED</button>
+              </>
+            ) : (
+              <small>Select a footprint or use LB / RB.</small>
+            )}
+            <div className="wb-add">
+              <button
+                disabled={!state.doc}
+                onClick={() => run(() => state.add("building"))}
+              >
+                + BUILDING BOX
+              </button>
+              <button
+                disabled={!state.doc}
+                onClick={() => run(() => state.add("road"))}
+              >
+                + ROAD BOX
+              </button>
+            </div>
+            <p>
+              One template repeats across the map. A single box is a coarse
+              shape; use several boxes to leave alleys or openings.
+            </p>
+            <p>
+              3D loads only this template’s existing GLBs on demand. Models are
+              not split or resized automatically.
+            </p>
+          </aside>
+        )}
+      </main>
+      <footer>
+        <span>{state.source}</span>
+        <output role="status">{state.status}</output>
+      </footer>
+    </section>
+  );
+}
diff --git a/frontend/src/worldBuilder/panels/EditorWorldControls.tsx b/frontend/src/worldBuilder/panels/EditorWorldControls.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..680ce9d94be3a1eb2a18dbbc98ecfd514dcb98dd
--- /dev/null
+++ b/frontend/src/worldBuilder/panels/EditorWorldControls.tsx
@@ -0,0 +1,82 @@
+import { mapCatalog } from "../../store/selection/worldCatalog";
+import { switchBuilderWorld } from "../state/builderActions";
+import { useBuilderStore } from "../state/builderStore";
+import {
+  EDITOR_THEMES,
+  useEditorPreferences,
+  type EditorTheme,
+} from "../state/editorPreferences";
+import type { DetailPreference } from "../vehicles/vehicleCatalog";
+
+export function EditorWorldControls({
+  compact = false,
+}: {
+  compact?: boolean;
+}) {
+  const source = useBuilderStore((s) => s.doc),
+    loading = useBuilderStore((s) => s.loadingMap),
+    preferences = useEditorPreferences();
+  const worlds =
+    source && !mapCatalog.some((m) => m.id === source.map_id)
+      ? [...mapCatalog, { id: source.map_id, name: source.map_id, desc: "" }]
+      : mapCatalog;
+  return (
+    <div className={`le-world-controls${compact ? " is-compact" : ""}`}>
+      <label className="le-header-field le-world-field">
+        <span>Editing world</span>
+        <select
+          aria-label="Editing world"
+          aria-busy={Boolean(loading)}
+          value={loading ?? source?.map_id ?? ""}
+          onChange={(e) => void switchBuilderWorld(e.target.value)}
+        >
+          {!source && !loading && (
+            <option value="" disabled>
+              Choose world
+            </option>
+          )}
+          {worlds.map((world) => (
+            <option key={world.id} value={world.id}>
+              {world.name}
+            </option>
+          ))}
+        </select>
+      </label>
+      {!compact && (
+        <>
+          <label className="le-header-field">
+            <span>Editor style</span>
+            <select
+              aria-label="Editor theme"
+              value={preferences.theme}
+              onChange={(e) =>
+                preferences.setTheme(e.target.value as EditorTheme)
+              }
+            >
+              <option value="shared">Use app theme</option>
+              {Object.entries(EDITOR_THEMES).map(([key, value]) => (
+                <option key={key} value={key}>
+                  {value.label}
+                </option>
+              ))}
+            </select>
+          </label>
+          <label className="le-header-field le-detail-field">
+            <span>Detail / LOD</span>
+            <select
+              aria-label="Editor detail"
+              value={preferences.detail}
+              onChange={(e) =>
+                preferences.setDetail(e.target.value as DetailPreference)
+              }
+            >
+              <option value="auto">Auto</option>
+              <option value="low">Low</option>
+              <option value="high">High</option>
+            </select>
+          </label>
+        </>
+      )}
+    </div>
+  );
+}
diff --git a/frontend/src/worldBuilder/panels/LayoutInspector.tsx b/frontend/src/worldBuilder/panels/LayoutInspector.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a25f9a511402024f4c5223dd93748a1778246d0e
--- /dev/null
+++ b/frontend/src/worldBuilder/panels/LayoutInspector.tsx
@@ -0,0 +1,685 @@
+import { useEffect, useRef, useState } from "react";
+import { useShallow } from "zustand/react/shallow";
+import { Icon, Thumbnail } from "../components/EditorArtwork";
+import { NumberField } from "../components/NumberField";
+import { pieceById, type V3 } from "../document/layoutDocument";
+import { ModelInspector } from "../models/ModelInspector";
+import { modelAsset, modelSolid } from "../models/modelCatalog";
+import { RoadInspector } from "../roads/RoadInspector";
+import { roadAsset, roleSolid } from "../roads/roadCatalog";
+import { useBuilderStore } from "../state/builderStore";
+import { useEditorPreferences } from "../state/editorPreferences";
+import { layoutAction, useLayoutStore } from "../state/layoutStore";
+import { SpawnInspector } from "./SpawnInspector";
+export function LayoutInspector({
+  planOnly,
+  modelReference,
+  setPreview,
+  projectAction,
+  importFile,
+  exportLayout,
+}: {
+  planOnly: boolean;
+  modelReference: boolean;
+  setPreview: (id: string) => void;
+  projectAction: (action: "new" | "example") => void;
+  importFile: (file: File) => Promise<void>;
+  exportLayout: () => void;
+}) {
+  const s = useLayoutStore(
+    useShallow((s) => ({
+      doc: s.doc,
+      selected: s.selected,
+      selectedSpawn: s.selectedSpawn,
+      placing: s.placing,
+      cursor: s.cursor,
+      placementYaw: s.placementYaw,
+      snap: s.snap,
+      angleSnap: s.angleSnap,
+      magnet: s.magnet,
+      snapBasis: s.snapBasis,
+      magnetRadius: s.magnetRadius,
+      wireframe: s.wireframe,
+      reference: s.reference,
+      view: s.view,
+      cameraRevision: s.cameraRevision,
+      commit: s.commit,
+      update: s.update,
+      place: s.place,
+      rotate: s.rotate,
+      select: s.select,
+      duplicate: s.duplicate,
+      remove: s.remove,
+      restore: s.restore,
+    })),
+  );
+  const [tab, setTab] = useState<
+    "selection" | "world" | "spawns" | "scene" | "snapping" | "files"
+  >(() => (s.selectedSpawn ? "spawns" : "selection"));
+  useEffect(
+    () =>
+      useLayoutStore.subscribe((state, previous) => {
+        if (
+          state.selectedSpawn !== previous.selectedSpawn &&
+          state.selectedSpawn
+        )
+          setTab("spawns");
+        else if (
+          (state.selected !== previous.selected ||
+            state.placing !== previous.placing) &&
+          (state.selected || state.placing)
+        )
+          setTab("selection");
+      }),
+    [],
+  );
+  const file = useRef<HTMLInputElement>(null),
+    preferences = useEditorPreferences(),
+    item = s.doc?.objects.find((o) => o.id === s.selected),
+    activePiece = s.placing ? pieceById(s.placing) : undefined;
+  const updateAxis = (
+    group: "position" | "size",
+    axis: number,
+    value: number,
+  ) => {
+    if (!item) return;
+    const v = [...item[group]] as V3;
+    v[axis] = value;
+    s.update({ [group]: v });
+  };
+  return (
+    <aside
+      id="world-inspector"
+      className="le-inspector"
+      data-compact={preferences.inspector === "compact"}
+    >
+      <nav className="le-inspector-tabs" aria-label="Inspector sections">
+        {(
+          [
+            "selection",
+            "spawns",
+            "world",
+            "scene",
+            "snapping",
+            "files",
+          ] as const
+        ).map((id) => (
+          <button key={id} aria-pressed={tab === id} onClick={() => setTab(id)}>
+            {id}
+          </button>
+        ))}
+      </nav>
+      {(tab === "selection" || tab === "world") && (
+        <>
+          <div className="le-section-title">
+            <span>
+              {tab === "world"
+                ? "WORLD SETTINGS"
+                : activePiece
+                  ? "PLACEMENT"
+                  : item
+                    ? "INSPECTOR"
+                    : "SELECTION"}
+            </span>
+            <Icon name={item ? "cube" : "layers"} />
+          </div>
+          {tab === "selection" && activePiece ? (
+            <div className="le-inspector-content">
+              <span className="le-small-label">READY TO PLACE</span>
+              <h2>{activePiece.label}</h2>
+              <p className="le-muted">{activePiece.description}</p>
+              <div className="le-active-thumb">
+                <Thumbnail piece={activePiece} />
+                <button
+                  className="le-wide"
+                  onClick={() => setPreview(activePiece.id)}
+                >
+                  Open 3D preview
+                </button>
+              </div>
+              <h3>
+                Cursor position <small>metres</small>
+              </h3>
+              <div className="le-number-row">
+                {["Cursor X", "Cursor Y", "Cursor Z"].map((label, i) => (
+                  <NumberField
+                    key={label}
+                    label={label}
+                    value={s.cursor[i]}
+                    step={s.snap}
+                    onCommit={(v) => {
+                      const cursor = [...s.cursor] as V3;
+                      cursor[i] = v;
+                      if (Math.abs(v) > 100000)
+                        throw Error("Cursor is out of range");
+                      useLayoutStore.setState({ cursor });
+                    }}
+                  />
+                ))}
+              </div>
+              <NumberField
+                label="Placement yaw"
+                value={s.placementYaw}
+                step={s.angleSnap}
+                onCommit={(placementYaw) => {
+                  if (Math.abs(placementYaw) > 36000)
+                    throw Error("Rotation is out of range");
+                  useLayoutStore.setState({ placementYaw });
+                }}
+              />
+              <button
+                className="le-primary le-wide"
+                onClick={() => layoutAction(() => s.place(s.cursor))}
+              >
+                + Place at cursor
+              </button>
+              <div className="le-twin">
+                <button onClick={() => layoutAction(() => s.rotate(-1))}>
+                  ↶ Turn left
+                </button>
+                <button onClick={() => layoutAction(() => s.rotate(1))}>
+                  ↷ Turn right
+                </button>
+              </div>
+              <button
+                className="le-wide"
+                onClick={() => useLayoutStore.setState({ placing: null })}
+              >
+                Finish placing · Esc
+              </button>
+              <p className="le-tip">
+                Click the ground to place repeated copies. The cursor fields
+                also work with a controller.
+              </p>
+            </div>
+          ) : tab === "selection" && item ? (
+            <div className="le-inspector-content">
+              <span className="le-small-label">
+                {item.piece.toUpperCase()} /{" "}
+                {s.doc!.objects.findIndex((o) => o.id === item.id) + 1}
+              </span>
+              <input
+                key={item.id + item.name}
+                className="le-object-name"
+                aria-label="Piece name"
+                defaultValue={item.name}
+                disabled={item.locked}
+                maxLength={80}
+                onBlur={(e) =>
+                  layoutAction(() => s.update({ name: e.currentTarget.value }))
+                }
+              />
+              <h3>
+                Position <small>metres · base elevation</small>
+              </h3>
+              <div className="le-number-row">
+                {["X", "Y", "Z"].map((axis, i) => (
+                  <NumberField
+                    key={axis}
+                    label={`Position ${axis}`}
+                    value={item.position[i]}
+                    step={s.snap}
+                    disabled={item.locked}
+                    onCommit={(v) => updateAxis("position", i, v)}
+                  />
+                ))}
+              </div>
+              <h3>
+                Dimensions <small>full size</small>
+              </h3>
+              <div className="le-number-row">
+                {["Width", "Height", "Depth"].map((axis, i) => (
+                  <NumberField
+                    key={axis}
+                    label={axis}
+                    value={item.size[i]}
+                    step={s.snap}
+                    disabled={item.locked}
+                    onCommit={(v) => updateAxis("size", i, v)}
+                  />
+                ))}
+              </div>
+              <h3>
+                Rotation <small>around Y</small>
+              </h3>
+              <div className="le-rotation">
+                <NumberField
+                  label="Yaw"
+                  value={item.yaw}
+                  step={s.angleSnap}
+                  disabled={item.locked}
+                  onCommit={(yaw) => s.update({ yaw })}
+                />
+                <button
+                  aria-label="Rotate left"
+                  disabled={item.locked}
+                  onClick={() => layoutAction(() => s.rotate(-1))}
+                >
+                  ↶
+                </button>
+                <button
+                  aria-label="Rotate right"
+                  disabled={item.locked}
+                  onClick={() => layoutAction(() => s.rotate(1))}
+                >
+                  ↷
+                </button>
+              </div>
+              {item.model && <ModelInspector item={item} />}{" "}
+              {item.vehicle && (
+                <>
+                  <label className="le-road-lod">
+                    Vehicle detail
+                    <select
+                      aria-label="Vehicle detail"
+                      value={item.vehicle.lod}
+                      disabled={item.locked}
+                      onChange={(e) =>
+                        layoutAction(() =>
+                          s.update({
+                            vehicle: {
+                              ...item.vehicle!,
+                              lod: e.target.value as "auto" | "proxy" | "full",
+                            },
+                          }),
+                        )
+                      }
+                    >
+                      <option value="auto">Auto LOD</option>
+                      <option value="proxy">Proxy</option>
+                      <option value="full">Prefer full</option>
+                    </select>
+                  </label>
+                  <p className="le-tip">
+                    Static traffic/background prop. Uses no player controls or
+                    vehicle simulation.
+                  </p>
+                </>
+              )}
+              <div className="le-twin">
+                <button onClick={() => setPreview(item.piece)}>
+                  Preview source
+                </button>
+                <button
+                  aria-label="Focus selected piece"
+                  onClick={() =>
+                    useLayoutStore.setState({
+                      focus: "selected",
+                      cameraRevision: s.cameraRevision + 1,
+                    })
+                  }
+                >
+                  Focus in world
+                </button>
+              </div>
+              {item.road && <RoadInspector item={item} />}
+              <label className="le-color">
+                Piece color
+                <input
+                  aria-label="Piece color"
+                  type="color"
+                  value={item.color}
+                  disabled={
+                    item.locked ||
+                    Boolean(item.road || item.model || item.vehicle)
+                  }
+                  onChange={(e) =>
+                    layoutAction(() => s.update({ color: e.target.value }))
+                  }
+                />
+                <code>{item.color}</code>
+              </label>
+              <label className="le-check">
+                <input
+                  type="checkbox"
+                  checked={item.solid}
+                  disabled={item.locked || Boolean(item.vehicle)}
+                  onChange={(e) =>
+                    layoutAction(() => s.update({ solid: e.target.checked }))
+                  }
+                />
+                <span>
+                  {item.vehicle
+                    ? "Background vehicle · no physics"
+                    : "Physical collisions"}
+                  <small>
+                    {item.model
+                      ? modelAsset(item.model.asset)!.colliders.filter((c) =>
+                          modelSolid(c.role, item.model!),
+                        ).length
+                      : item.road
+                        ? roadAsset(item.road.asset)!.colliders.filter((c) =>
+                            roleSolid(c.role, item.road!),
+                          ).length
+                        : item.parts.filter((p) => p.solid !== false)
+                            .length}{" "}
+                    {item.road || item.model
+                      ? "measured surface groups"
+                      : "explicit shapes"}
+                  </small>
+                </span>
+              </label>
+              <label className="le-check">
+                <input
+                  type="checkbox"
+                  checked={item.locked}
+                  onChange={(e) =>
+                    layoutAction(() => s.update({ locked: e.target.checked }))
+                  }
+                />
+                <span>Lock this piece</span>
+              </label>
+              <div className="le-twin">
+                <button onClick={() => layoutAction(s.duplicate)}>
+                  <Icon name="duplicate" />
+                  Duplicate
+                </button>
+                <button
+                  disabled={item.locked}
+                  className="le-delete"
+                  onClick={() => layoutAction(s.remove)}
+                >
+                  Delete
+                </button>
+              </div>
+              <p className="le-tip">
+                {item.piece === "ramp"
+                  ? `Slope ${Math.round((Math.atan2(item.size[1], item.size[2]) * 180) / Math.PI)}°. The high edge faces local −Z.`
+                  : item.piece === "garage"
+                    ? "The walls, roof and front opening are separate shapes. You can drive through the opening."
+                    : "Use the handles in Perspective, drag in Plan with Move, or enter exact measurements."}
+              </p>
+            </div>
+          ) : tab === "selection" ? (
+            <p className="le-tip">
+              Select a piece in the world or choose a prefab from the library.
+              World settings, spawns, files and snapping have their own tabs.
+            </p>
+          ) : (
+            <div className="le-inspector-content">
+              <span className="le-small-label">PROJECT SETTINGS</span>
+              <h2>World settings</h2>
+              <label className="le-check">
+                <input
+                  type="checkbox"
+                  checked={s.doc?.base === "overlay"}
+                  disabled={!s.doc}
+                  onChange={(e) =>
+                    layoutAction(() => {
+                      if (s.doc)
+                        s.commit({
+                          ...s.doc,
+                          base: e.target.checked ? "overlay" : "replace",
+                        });
