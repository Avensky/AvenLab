+} from "../roads/layoutSnapping";
+import { roadAsset, roleSolid, roleVisible } from "../roads/roadCatalog";
+import { useBuilderStore } from "../state/builderStore";
+import {
+  useEditorPalette,
+  useEditorPreferences,
+} from "../state/editorPreferences";
+import { layoutAction, useLayoutStore } from "../state/layoutStore";
+
+function planFrame(
+  objects: LayoutObject[],
+  cell?: [number, number],
+  tight = false,
+  spawns: LayoutSpawn[] = [],
+): PlanBounds {
+  const points = [
+      ...objects.flatMap(footprint),
+      ...spawns.map((p) => [p.position[0], p.position[2]]),
+    ],
+    xs = points.map((p) => p[0]),
+    zs = points.map((p) => p[1]);
+  const x =
+      tight && points.length
+        ? Math.min(...xs)
+        : Math.min(cell ? -cell[0] / 2 : -35, ...xs),
+    z =
+      tight && points.length
+        ? Math.min(...zs)
+        : Math.min(cell ? -cell[1] / 2 : -35, ...zs);
+  const width =
+      (tight && points.length
+        ? Math.max(...xs)
+        : Math.max(cell ? cell[0] / 2 : 35, ...xs)) - x,
+    depth =
+      (tight && points.length
+        ? Math.max(...zs)
+        : Math.max(cell ? cell[1] / 2 : 35, ...zs)) - z;
+  const pad = tight ? Math.max(3, Math.max(width, depth) * 0.15) : 10;
+  return {
+    x: x - pad,
+    z: z - pad,
+    width: width + pad * 2,
+    depth: depth + pad * 2,
+  };
+}
+const pointsFor = (o: LayoutObject) =>
+  footprint(o)
+    .map((p) => p.join(","))
+    .join(" ");
+function PieceFootprint({
+  item,
+  ghost = false,
+  collisionOnly = false,
+}: {
+  item: LayoutObject;
+  ghost?: boolean;
+  collisionOnly?: boolean;
+}) {
+  if (item.vehicle) {
+    return collisionOnly ? null : (
+      <g
+        transform={`translate(${item.position[0]} ${item.position[2]}) rotate(${-item.yaw}) scale(${item.size[0]} ${item.size[2]})`}
+        opacity={ghost ? 0.5 : 1}
+      >
+        <rect
+          x="-.48"
+          y="-.48"
+          width=".96"
+          height=".96"
+          rx=".12"
+          fill={item.color}
+        />
+        <rect x="-.38" y="-.2" width=".76" height=".42" fill="#21384b" />
+        <path
+          d="m-.15 -.3 .15-.12 .15 .12"
+          fill="none"
+          stroke="#d4efff"
+          strokeWidth=".05"
+        />
+      </g>
+    );
+  }
+  if (item.model) {
+    const a = modelAsset(item.model.asset)!;
+    return (
+      <g
+        transform={`translate(${item.position[0]} ${item.position[2]}) rotate(${-item.yaw}) scale(${item.size[0] / a.size[0]} ${item.size[2] / a.size[2]})`}
+        opacity={ghost ? 0.5 : 1}
+      >
+        {a.colliders
+          .filter((c) =>
+            collisionOnly
+              ? item.solid && modelSolid(c.role, item.model!)
+              : item.model!.visible[c.role],
+          )
+          .map((c) => (
+            <path
+              key={c.role}
+              d={c.indices
+                .map(
+                  (tri) =>
+                    tri
+                      .map(
+                        (index, k) =>
+                          `${k ? "L" : "M"}${c.vertices[index][0]} ${c.vertices[index][2]}`,
+                      )
+                      .join("") + "Z",
+                )
+                .join("")}
+              fill={
+                collisionOnly
+                  ? "none"
+                  : c.role === "floor"
+                    ? "#385674"
+                    : c.role === "roof"
+                      ? "#91a7b1"
+                      : "#61899c"
+              }
+              fillOpacity={c.role === "roof" ? 0.25 : 1}
+              stroke={collisionOnly ? "#4ce2b0" : "#0b1926"}
+              strokeWidth=".6"
+              vectorEffect="non-scaling-stroke"
+            />
+          ))}
+      </g>
+    );
+  }
+  if (item.road) {
+    const asset = roadAsset(item.road.asset)!,
+      r = -item.yaw;
+    return (
+      <g
+        transform={`translate(${item.position[0]} ${item.position[2]}) rotate(${r}) scale(${item.size[0] / asset.size[0]} ${item.size[2] / asset.size[2]})`}
+        opacity={ghost ? 0.5 : 1}
+      >
+        {asset.colliders
+          .filter((c) =>
+            collisionOnly
+              ? item.solid && roleSolid(c.role, item.road!)
+              : roleVisible(c.role, item.road!.variant),
+          )
+          .map((c) => (
+            <path
+              key={c.role}
+              d={c.indices
+                .map(
+                  (tri) =>
+                    tri
+                      .map(
+                        (index, k) =>
+                          `${k ? "L" : "M"}${c.vertices[index][0]} ${c.vertices[index][2]}`,
+                      )
+                      .join("") + "Z",
+                )
+                .join("")}
+              fill={
+                collisionOnly
+                  ? "none"
+                  : c.role === "surface"
+                    ? "#33475d"
+                    : "#889ca5"
+              }
+              stroke={collisionOnly ? "#50e5b2" : "none"}
+              strokeWidth=".5"
+              vectorEffect="non-scaling-stroke"
+            />
+          ))}
+      </g>
+    );
+  }
+  return (
+    <g opacity={ghost ? 0.5 : 1}>
+      {item.parts
+        .filter((p) => !collisionOnly || (item.solid && p.solid !== false))
+        .map((part, i) => {
+          const t = partTransform(item, part),
+            local = {
+              ...item,
+              position: [t.position[0], 0, t.position[2]] as V3,
+              size: t.size,
+            };
+          return (
+            <polygon
+              key={i}
+              points={pointsFor(local)}
+              fill={
+                collisionOnly
+                  ? "none"
+                  : ghost
+                    ? "#64e3bf"
+                    : (part.color ?? item.color)
+              }
+              stroke={collisionOnly ? "#4ce2b0" : "#0b1926"}
+              strokeWidth={collisionOnly ? "1" : ".5"}
+              vectorEffect="non-scaling-stroke"
+            />
+          );
+        })}
+      {item.piece === "ramp" && (
+        <path
+          d={`M${item.position[0]} ${item.position[2] + item.size[2] * 0.3}v${-item.size[2] * 0.6}m-1 2 1-2 1 2`}
+          transform={`rotate(${-item.yaw},${item.position[0]},${item.position[2]})`}
+          fill="none"
+          stroke="#f3edcf"
+          strokeWidth="1.5"
+          vectorEffect="non-scaling-stroke"
+        />
+      )}
+    </g>
+  );
+}
+export function LayoutPlan() {
+  const source = useBuilderStore((s) => s.doc),
+    reference = useMemo(() => (source ? editableBoxes(source) : []), [source]);
+  const preferences = useEditorPreferences(),
+    palette = useEditorPalette();
+  const doc = useLayoutStore((s) => s.doc),
+    selected = useLayoutStore((s) => s.selected),
+    placing = useLayoutStore((s) => s.placing),
+    yaw = useLayoutStore((s) => s.placementYaw),
+    cursor = useLayoutStore((s) => s.cursor),
+    tool = useLayoutStore((s) => s.tool),
+    grid = useLayoutStore((s) => s.snap);
+  const wireframe = useLayoutStore((s) => s.wireframe),
+    focus = useLayoutStore((s) => s.focus),
+    selectedSpawn = useLayoutStore((s) => s.selectedSpawn);
+  const [view, setView] = useState(() =>
+    planFrame(
