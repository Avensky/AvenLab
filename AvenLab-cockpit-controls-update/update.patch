+  border-right-color: #ef776b;
+}
+.knob-pointer {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+}
+.knob-pointer:before {
+  content: "";
+  position: absolute;
+  left: calc(50% - 1px);
+  top: 0;
+  width: 2px;
+  height: 7px;
+  background: #eef8fc;
+}
+.climate-three-knobs .climate-knob button {
+  position: absolute;
+  inset: 27% 16% 25%;
+  padding: 0;
+  min-height: 0;
+  border: 1px solid #5e7079;
+  border-radius: 50%;
+  background: #111e29;
+  font: 4px monospace;
+  color: #dceaf1;
+}
+.climate-knob button[aria-pressed="true"] {
+  color: #ffbc53;
+  border-color: #bd9051;
+}
+.climate-knob output {
+  position: absolute;
+  bottom: -5px;
+  left: -5px;
+  right: -5px;
+  text-align: center;
+  font: 5px/1 monospace;
+  pointer-events: none;
+  color: #dbeaf2;
+  background: #07111b9c;
+}
+@media (max-height: 400px) {
+  .driving-hud {
+    --console-width: 166px;
+  }
+  .climate-three-knobs {
+    gap: 4px;
+    padding-top: 9px;
+  }
+  .drive-dock .driving-pedal {
+    height: 34px;
+    width: 42px;
+  }
+  .drive-dock .driving-pedal img {
+    height: 18px;
+  }
+  .drive-dock .driving-pedal small {
+    font-size: 6px;
+  }
+}
+.driving-pedal {
+  --pedal-icon-height: 27px;
+}
+.driving-pedal.driving-reverse > span {
+  display: grid;
+  place-items: center;
+  flex: none;
+  height: var(--pedal-icon-height);
+  line-height: 1;
+  font-size: var(--pedal-icon-height);
+}
+@media (max-height: 450px) {
+  .driving-pedal {
+    --pedal-icon-height: 22px;
+  }
+}
+@media (max-height: 320px) {
+  .driving-pedal {
+    --pedal-icon-height: 17px;
+  }
+}
+@media (max-height: 400px) {
+  .drive-dock .driving-pedal {
+    --pedal-icon-height: 18px;
+  }
+}
+
+/* Research HUD: quiet controls, painted wheel hit regions, fixed pedal space. */
+.wheel-assembly > .steering-control {
+  z-index: 2;
+  pointer-events: none;
+  background: transparent;
+  border: 0;
+  box-shadow: none;
+}
+.wheel-assembly .wheel-rotor,
+.wheel-assembly .wheel-artwork {
+  pointer-events: none;
+}
+.wheel-artwork :is(path, circle, ellipse, rect, text) {
+  pointer-events: visiblePainted;
+}
+.drive-dock {
+  display: flex;
+  flex-direction: column;
+  overflow: visible;
+}
+.dock-equipment {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  min-height: 0;
+  overflow: auto;
+  flex: 0 1 auto;
+}
+.drive-dock .pedal-hud {
+  flex: 0 0 auto;
+  min-height: 0;
+}
+
+.radio-transport {
+  display: flex;
+  gap: 2px;
+  align-items: center;
+  padding: 2px 0;
+  min-width: 0;
+}
+:is(.drive-dock, .cockpit-panel) .radio-transport > button {
+  flex: 1;
+  min-width: 0;
+  height: 23px;
+  min-height: 23px;
+  padding: 1px;
+  border-radius: 50%;
+  font: 11px/1 monospace;
+}
+.radio-volume-dial {
+  flex: 0 0 27px;
+  width: 27px;
+  height: 32px;
+  margin-left: 2px;
+  padding-top: 3px;
+}
+.radio-volume-dial .climate-knob {
+  width: 25px;
+  height: 25px;
+  border-width: 1px;
+}
+.radio-volume-dial .knob-title {
+  display: none;
+}
+.radio-volume-dial .knob-pointer:before {
+  height: 4px;
+}
+.radio-volume-dial .climate-knob > button {
+  position: absolute;
+  inset: 24%;
+  padding: 0;
+  min-height: 0;
+  min-width: 0;
+  font-size: 8px;
+  border-radius: 50%;
+}
+.radio-volume-dial output {
+  font-size: 5px;
+  bottom: -5px;
+  left: 0;
+  right: 0;
+}
+.radio-display .radio-vehicle-status[data-alert="true"] {
+  color: #ffb76a;
+  font-weight: 700;
+  letter-spacing: 0.02em;
+}
+
+/* One rotary key beside the console, leaving the vehicle center clear. */
+.driving-hud button {
+  -webkit-tap-highlight-color: transparent;
+}
+
+/* Stalk feedback follows the physical hold, never hover or retained focus. */
+
+/* Confirmed function state is separate from contact feedback on console controls. */
+:is([data-momentary-controls] button, button[data-momentary-controls]) {
+  border-color: var(--contact-border, var(--app-line, #626e7a88)) !important;
+  background: var(--contact-surface, var(--app-panel, #111a24)) !important;
+  color: var(--contact-ink, var(--app-text, #dce4e9)) !important;
+  outline: 0 !important;
+  box-shadow: none !important;
+  -webkit-tap-highlight-color: transparent;
+}
+[data-momentary-controls] .component-minimize {
+  --contact-border: #627e8c50;
+  --contact-surface: transparent;
+  --contact-ink: #bed7e0;
+}
+[data-momentary-controls] .physical-hazard {
+  --contact-border: #934143;
+  --contact-surface: linear-gradient(#611e20, #351416);
+  --contact-ink: #ff8079;
+}
+[data-momentary-controls] .console-display-tabs button {
+  --contact-border: #3e5967;
+  --contact-surface: #10212c;
+  --contact-ink: #a8bfc9;
+}
+[data-momentary-controls] .climate-knob > button {
+  --contact-border: #5e7079;
+  --contact-surface: #111e29;
+  --contact-ink: #dceaf1;
+}
+:is(
+  [data-momentary-controls] button,
+  button[data-momentary-controls]
+)[data-hud-held="true"] {
+  border-color: var(--app-accent, #a7dbe9) !important;
+  background: var(--app-raised, #1e3b49) !important;
+  color: var(--app-text, #effbff) !important;
+  outline: 1px solid var(--app-accent, #a7dbe9) !important;
+  outline-offset: -2px;
+}
+[data-momentary-controls] .climate-knob[data-hud-held="true"] {
+  border-color: #a7dbe9;
+  box-shadow: 0 0 0 1px #a7dbe9;
+}
+.console-display[data-expanded="true"],
+.climate-panel[data-expanded="true"] {
+  border-color: #8eb5c4;
+}
+
+/* Keyboard focus is a thin locator, never a depressed switch face. */
+[data-momentary-controls] button:focus-visible {
+  text-decoration: underline;
+  text-underline-offset: 3px;
+}
diff --git a/frontend/src/ui/Cockpit/styles/ignition.css b/frontend/src/ui/Cockpit/styles/ignition.css
new file mode 100644
index 0000000000000000000000000000000000000000..d7f2949c203509f578898929998f6adbc05b439b
--- /dev/null
+++ b/frontend/src/ui/Cockpit/styles/ignition.css
@@ -0,0 +1,114 @@
+/* Ring radius 61 is outside the radius-54 labels. The key gesture controls the
+   progress arc; only confirmed Rust STARTING controls crank flicker/audio. */
+.ignition-system {
+  display: block;
+  height: auto;
+  --contact-surface: transparent;
+  --contact-border: transparent;
+}
+.ignition-system .ignition-cylinder {
+  position: relative;
+  display: block;
+  width: 128px;
+  height: 128px;
+  margin: auto;
+  padding: 0;
+  border: 0 !important;
+  border-radius: 50%;
+  outline: 0 !important;
+  box-shadow: none !important;
+  background: transparent !important;
+  touch-action: none;
+}
+.ignition-cylinder svg {
+  display: block;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+}
+.ignition-cylinder [data-key-position] {
+  pointer-events: none;
+}
+.radial-key {
+  transition: transform 100ms linear;
+}
+.ignition-ring {
+  opacity: 0.22;
+  filter: drop-shadow(0 0 2px var(--app-accent, #9ae6ff));
+}
+.ignition-system:is([data-ignition="ACC"], [data-ignition="ON"])
+  .ignition-ring {
+  opacity: 0.55;
+}
+.ignition-system[data-holding="true"] .ignition-ring,
+.ignition-system:has([data-hud-held="true"]) .ignition-ring {
+  opacity: 1;
+  stroke-width: 3;
+  filter: drop-shadow(0 0 4px var(--app-accent, #9ae6ff));
+}
+.key-travel {
+  opacity: 0;
+  stroke: var(--app-text, #d4f5ff);
+  transition: stroke-dashoffset 130ms linear;
+  pointer-events: none;
+}
+.ignition-system[data-holding="true"] .key-travel {
+  opacity: 1;
+}
+.ignition-system[data-cranking="true"] .ignition-ring {
+  animation: starter-ring-click 230ms steps(2, end) infinite;
+}
+@keyframes starter-ring-click {
+  0%,
+  100% {
+    opacity: 1;
+  }
+  45% {
+    opacity: 0.55;
+  }
+  70% {
+    opacity: 0.85;
+  }
+}
+.driving-hud .ignition-hud {
+  left: auto;
+  right: calc(var(--console-width) + clamp(24px, 5vw, 72px));
+  top: auto;
+  bottom: max(10px, env(safe-area-inset-bottom));
+  width: 84px;
+  transform: none;
+}
+.ignition-hud .ignition-cylinder {
+  width: 100%;
+  height: auto;
+  aspect-ratio: 1;
+}
+.cockpit-ignition-page {
+  height: 165px;
+}
+html[data-reduce-motion="true"]
+  .ignition-system[data-cranking="true"]
+  .ignition-ring {
+  opacity: 1;
+  animation: none;
+}
+html[data-reduce-motion="true"] :is(.radial-key, .key-travel) {
+  transition: none;
+}
+@media (prefers-reduced-motion: reduce) {
+  .ignition-system[data-cranking="true"] .ignition-ring {
+    opacity: 1;
+    animation: none;
+  }
+  .radial-key,
+  .key-travel {
+    transition: none;
+  }
+}
+@media (max-width: 600px) and (orientation: portrait) {
+  .driving-hud .ignition-hud {
+    right: calc(var(--console-width) + 16px);
+    bottom: 184px;
+    width: 54px;
+  }
+}
diff --git a/frontend/src/ui/Cockpit/styles/index.css b/frontend/src/ui/Cockpit/styles/index.css
new file mode 100644
index 0000000000000000000000000000000000000000..d9ee3e86cdc4eb6210420a1453a003626f3e4eb2
--- /dev/null
+++ b/frontend/src/ui/Cockpit/styles/index.css
@@ -0,0 +1,9 @@
+/* CSS public entry: base surfaces first, each physical feature after its base.
+   Keep geometry in the corresponding TS helper; change appearance here. */
+@import "./console.css";
+@import "./layout.css";
+@import "./mechanical.css";
+@import "./stalks.css";
+@import "./ignition.css";
+@import "./panels.css";
+@import "./switches.css";
diff --git a/frontend/src/ui/Cockpit/styles/layout.css b/frontend/src/ui/Cockpit/styles/layout.css
new file mode 100644
index 0000000000000000000000000000000000000000..a4a81487fb6a576da65269db658bb5d20f25a394
--- /dev/null
+++ b/frontend/src/ui/Cockpit/styles/layout.css
@@ -0,0 +1,65 @@
+/* The parking lever and shifter share a row. A 72px assist bank fits next to
+   pedals on wide screens and wraps above them on a narrow phone. */
+.transmission-console {
+  --shifter-size: 90px;
+  --parking-control-height: var(--shifter-size);
+  display: grid;
+  grid-template-columns: minmax(60px, 1fr) var(--shifter-size);
+  grid-template-rows: auto;
+  gap: 5px;
+  align-items: start;
+  width: 100%;
+  max-width: 220px;
+  margin: auto;
+}
+.transmission-console > .mechanical-handbrake,
+.hud-transmission > .hud-parking {
+  grid-column: 1;
+  grid-row: 1;
+}
+.transmission-console > .mechanical-shifter,
+.hud-transmission > .hud-shifter {
+  grid-column: 2;
+  grid-row: 1;
+}
+.transmission-console > .drive-assists {
+  grid-column: 1 / -1;
+  grid-row: 2;
+}
+.drive-dock .hud-transmission {
+  margin-top: 3px;
+}
+.console-foot-controls {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: flex-end;
+  align-items: flex-end;
+  gap: 4px;
+  flex: 0 0 auto;
+}
+.drive-dock .console-foot-controls .hud-assists {
+  flex: 0 0 72px;
+  width: 72px;
+}
+.drive-dock .console-foot-controls .pedal-hud {
+  display: block;
+  flex: 0 0 auto;
+  width: auto;
+}
+.drive-dock .hud-transmission:not(:has(> .hud-parking)),
+.drive-dock .hud-transmission:not(:has(> .hud-shifter)) {
+  grid-template-columns: 1fr;
+}
+.drive-dock .hud-transmission:not(:has(> .hud-parking)) > .hud-shifter {
+  grid-column: 1;
+  justify-self: end;
+}
+.drive-dock .hud-transmission:not(:has(> .hud-shifter)) > .hud-parking {
+  max-width: 90px;
+  justify-self: end;
+}
+.hud-hazards {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+}
diff --git a/frontend/src/ui/Cockpit/styles/mechanical.css b/frontend/src/ui/Cockpit/styles/mechanical.css
new file mode 100644
index 0000000000000000000000000000000000000000..81420c841569be6698ca1cef3cc9691bf398bffd
--- /dev/null
+++ b/frontend/src/ui/Cockpit/styles/mechanical.css
@@ -0,0 +1,317 @@
+/* The physical gate is a fixed circle. Rust confirms selection; only its knob
+   changes position, so steering/pedals never rebuild this static gate artwork. */
+.mechanical-shifter,
+.mechanical-handbrake {
+  min-width: 0;
+  text-align: center;
+}
+.transmission-console .shift-gate {
+  box-sizing: border-box;
+  position: relative;
+  width: var(--shifter-size, 90px);
+  height: var(--shifter-size, 90px);
+  margin: 0;
+  border: 4px solid #b0b5bd;
+  border-radius: 50%;
+  background: radial-gradient(ellipse at 35% 20%, #393a3d, #0a0d12 65%);
+  box-shadow:
+    inset 0 0 0 2px #555a62,
+    0 0 0 1px #08090d;
+}
+.shift-gate > svg {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  fill: none;
+  stroke: #5d656f;
+  stroke-width: 5;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+:is(.cockpit-panel, .drive-dock) .mechanical-shifter .shift-slot {
+  box-sizing: border-box;
+  position: absolute;
+  transform: translate(-50%, -50%);
+  width: 17px;
+  height: 17px;
+  min-height: 0;
+  min-width: 0;
+  padding: 0;
+  border: 1px solid #737a83;
+  border-radius: 2px;
+  z-index: 1;
+  font: 7px monospace;
+}
+:is(.cockpit-panel, .drive-dock) .mechanical-shifter .shift-knob {
+  box-sizing: border-box;
+  position: absolute;
+  transform: translate(-50%, -50%);
+  width: 26px;
+  height: 26px;
+  min-height: 0;
+  padding: 2px;
+  border: 2px solid #b8bec4;
+  border-radius: 50%;
+  z-index: 2;
+  touch-action: none;
+  --contact-surface: radial-gradient(circle at 30% 15%, #56595f, #191c22 70%);
+}
+.mechanical-shifter .shift-knob span {
+  display: block;
+  white-space: pre;
+  font-size: 5px;
+  line-height: 1.7;
+  pointer-events: none;
+}
+.mechanical-shifter > small {
+  display: block;
+  padding-top: 4px;
+  font-size: 7px;
+}
+.hud-transmission .mechanical-shifter > small {
+  display: none;
+}
+/* A rear-brake pull is as tall as the shifter, with a subtle stitched grip and
+   metal release cap. Simple mode swaps only artwork, not control behavior. */
+.transmission-console .mechanical-handbrake {
+  position: relative;
+  height: var(--parking-control-height, 90px);
+  width: 100%;
+}
+.mechanical-handbrake .handbrake-lever {
+  position: relative;
+  display: block;
+  width: 100%;
+  height: 100%;
+  min-height: 0;
+  padding: 0 18px 0 0;
+  border: 0 !important;
+  outline: 0 !important;
+  background: transparent !important;
+  box-shadow: none !important;
+  touch-action: none;
+}
+.mechanical-handbrake > small {
+  display: none;
+}
+.ebrake-floor {
+  position: absolute;
+  left: 14%;
+  right: 18%;
+  bottom: 3%;
+  height: 9%;
+  border-radius: 50%;
+  background: #0004;
+}
+.mechanical-handbrake .ebrake-base {
+  position: absolute;
+  left: 14%;
+  top: 76%;
+  width: 70%;
+  height: 19%;
+  transform: none;
+  border: 0;
+  background: none;
+}
+.ebrake-base svg {
+  width: 100%;
+  height: 100%;
+  fill: #21272e;
+  stroke: #66717a;
+  stroke-width: 1.5;
+}
+.mechanical-handbrake .handbrake-lever .ebrake-handle {
+  position: absolute;
+  left: 43%;
+  top: 82%;
+  width: min(65%, 64px);
+  height: 11%;
+  transform-origin: 5% 50%;
+  transform: rotate(var(--parking-angle, -115deg))
+    scaleX(var(--parking-reach, 0.72));
+  border: 0;
+  border-radius: 0;
+  clip-path: none;
+  background: none;
+}
+.ebrake-handle svg {
+  display: block;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+  fill: #59636c;
+  stroke: #10151a;
+  stroke-width: 1;
+}
+.ebrake-handle .parking-grip {
+  fill: #1c242b;
+  stroke: #67747e;
+}
+.ebrake-handle .parking-stitch {
+  fill: none;
+  stroke: #a3aab0;
+  stroke-width: 0.8;
+  stroke-dasharray: 2 2;
+}
+.handbrake-lever[data-hud-held="true"] .ebrake-handle {
+  filter: drop-shadow(0 0 2px var(--app-accent, #9ae6ff));
+}
+.parking-pull-label {
+  position: absolute;
+  left: 2px;
+  bottom: 1px;
+  color: var(--app-muted, #aab8c2);
+  font: 6px/1 monospace;
+  letter-spacing: 0.06em;
+}
+.parking-simple-face {
+  display: none;
+  position: absolute;
+  inset: 14% 19% 14% 0;
+  width: 74%;
+  height: 72%;
+  fill: #101a24;
+  stroke: #a6bacb;
+  stroke-width: 2;
+}
+.parking-simple-face path {
+  fill: none;
+}
+[data-parking-style="button"] .parking-simple-face {
+  display: block;
+}
+[data-parking-style="button"] :is(.ebrake-floor, .ebrake-base, .ebrake-handle) {
+  display: none;
+}
+[data-parking-style="button"]
+  .handbrake-lever[data-hud-held="true"]
+  .parking-simple-face {
+  stroke: var(--app-accent, #9ae6ff);
+  filter: drop-shadow(0 0 2px var(--app-accent, #9ae6ff));
+}
+/* Crystals are optional. Plain 1/2/3 detents retain the same explicit latch API. */
+.mechanical-handbrake .parking-levels {
+  position: absolute;
+  top: 0;
+  right: 0;
+  bottom: 0;
+  z-index: 3;
+  width: 17px;
+  display: grid;
+  grid-template-rows: repeat(3, minmax(0, 1fr));
+  gap: 2px;
+  --contact-surface: transparent;
+  --contact-border: transparent;
+}
+.mechanical-handbrake.drift-parking .parking-levels {
+  bottom: 17px;
+}
+:is(.cockpit-panel, .drive-dock) .mechanical-handbrake .parking-levels button {
+  display: grid;
+  place-items: center;
+  min-height: 0;
+  min-width: 0;
+  padding: 0;
+  height: auto;
+  border: 0;
+  background: none;
+  line-height: 1;
+}
+.parking-crystal {
+  display: block;
+  width: 9px;
+  height: 100%;
+  max-height: 27px;
+  opacity: 0.5;
+}
+.parking-crystal path {
+  fill: #10263466;
+  stroke: #73c8e1;
+  stroke-width: 1;
+  stroke-dasharray: 2 1;
+}
+[data-filled="true"] > .parking-crystal {
+  opacity: 1;
+}
+[data-filled="true"] > .parking-crystal path {
+  fill: #68c8f0;
+  stroke: #b0eaff;
+  stroke-dasharray: none;
+}
+.parking-detent-value {
+  color: var(--app-muted, #97a6b2);
+  font: 7px monospace;
+}
+[data-filled="true"] > .parking-detent-value {
+  color: var(--app-accent, #9ae6ff);
+  text-decoration: underline;
+}
+:is(.cockpit-panel, .drive-dock) .mechanical-handbrake .parking-release {
+  position: absolute;
+  right: 0;
+  bottom: 0;
+  z-index: 3;
+  width: 17px;
+  height: 15px;
+  min-height: 0;
+  padding: 0;
+  font: 7px monospace;
+}
+/* Five assist switches occupy a 3x2 bank. In the HUD each switch is around half
+   a pedal's width/height; the empty sixth cell is intentional, not a fake action. */
+.drive-assists {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  grid-template-rows: repeat(2, minmax(0, 1fr));
+  gap: 2px;
+  height: 72px;
+  padding: 0;
+}
+:is(.drive-dock, .cockpit-panel) .drive-assists button {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  min-width: 0;
+  min-height: 0;
+  height: auto;
+  margin: 0;
+  padding: 2px;
+  font: 7px/1 monospace;
+}
+.drive-assists button span {
+  font-size: 6px;
+}
+.drive-assists .assist-trac-content {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 1px;
+}
+.drive-assists img {
+  display: block;
+  width: 10px;
+  height: 9px;
+  object-fit: contain;
+}
+.drive-assists small {
