-def normalized_byte_change_rates(
-    frame_count: int,
-    byte_change_counts: dict[str, int],
-) -> dict[str, float]:
-    transitions = max(int(frame_count) - 1, 1)
-    return {
-        str(byte_index): round(
-            float(byte_change_counts.get(str(byte_index), 0) or 0)
-            / transitions,
-            8,
-        )
-        for byte_index in range(8)
-    }
