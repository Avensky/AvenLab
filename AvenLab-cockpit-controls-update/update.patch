-        if len(set(values)) < 2:
-            continue
-
-        observations: list[FieldMarkerObservation] = []
-        action_intervals: list[tuple[int, int]] = []
-        expected_values: list[float] = []
-        observed_values: list[float] = []
-        plateau_mads: list[float] = []
