+    const floor = source?.surface.road_y ?? 0;
+    useLayoutStore.setState({
+      placing: piece.id,
+      selected: null,
+      cursor: [
+        useLayoutStore.getState().cursor[0],
+        floor - (piece.category === "roads" && !piece.road ? piece.size[1] : 0),
+        useLayoutStore.getState().cursor[2],
