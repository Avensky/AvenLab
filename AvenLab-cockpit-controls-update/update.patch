diff --git a/frontend/src/components/README.md b/frontend/src/components/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..b1bb4e2fcb364bbee5da376cc5c1c04af2c132b7
--- /dev/null
+++ b/frontend/src/components/README.md
@@ -0,0 +1,7 @@
+# Reusable presentation
+
+GameButton.tsx is shared main/pause interaction. menus/ owns menu surfaces/focus. controller/ owns Xbox glyphs and shortcut guides. debugger/ owns optional physics visualizers.
+
+## How to edit
+
+Prefer existing shared components. Vehicle transforms/camera math belong to their feature, not a generic component. See debugger/README for diagnostics and theme/README for colors.
diff --git a/frontend/src/components/controller/ControllerButton.tsx b/frontend/src/components/controller/ControllerButton.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..0f4996e7ce690dce9e22af82b50cc3a3b5a65191
--- /dev/null
+++ b/frontend/src/components/controller/ControllerButton.tsx
@@ -0,0 +1,55 @@
+import "./controller.css";
+export type ControllerKey =
+  | "A"
+  | "B"
+  | "X"
+  | "Y"
+  | "LB"
+  | "RB"
+  | "LT"
+  | "RT"
+  | "LS"
+  | "RS"
+  | "VIEW"
+  | "START"
+  | "D-PAD";
+/** Xbox glyphs keep a black fill and semantic face-button color in every theme. */
+export function ControllerButton({ button }: { button: ControllerKey }) {
+  return (
+    <kbd
+      className="controller-key"
+      data-controller-key={button}
+      aria-label={`Xbox ${button}`}
+    >
+      {button}
+    </kbd>
+  );
+}
+export function MenuShortcuts({
+  back = true,
+  tabs = true,
+  hold = false,
+}: { back?: boolean; tabs?: boolean; hold?: boolean } = {}) {
+  return (
+    <div className="controller-shortcuts" aria-label="Menu shortcuts">
+      <span>
+        <ControllerButton button="D-PAD" /> Navigate <kbd>↑↓</kbd>
+      </span>
+      <span>
+        <ControllerButton button="A" /> {hold ? "Select / hold" : "Select"}{" "}
+        <kbd>Enter</kbd>
+      </span>
+      {tabs && (
+        <span>
+          <ControllerButton button="LB" />
+          <ControllerButton button="RB" /> Tabs <kbd>Q / E</kbd>
+        </span>
+      )}
+      {back && (
+        <span>
+          <ControllerButton button="B" /> Back <kbd>Esc</kbd>
+        </span>
+      )}
+    </div>
+  );
+}
diff --git a/frontend/src/components/controller/ControllerGuide.tsx b/frontend/src/components/controller/ControllerGuide.tsx
