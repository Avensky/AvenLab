+
+function byteHex(value: number | undefined) {
+  if (typeof value !== "number") return "--";
+  return value.toString(16).toUpperCase().padStart(2, "0");
+}
+
+function canIdHex(value: number) {
+  const width = value <= 0x7ff ? 3 : 8;
