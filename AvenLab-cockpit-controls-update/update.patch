+  height: 49px;
+}
+.drive-dock .hud-assists .drive-assists button {
+  padding: 0;
+  font-size: 5px;
+}
+.drive-dock .hud-assists .drive-assists button span {
+  font-size: 4px;
+}
+.drive-dock .hud-assists .drive-assists img {
+  width: 8px;
+  height: 7px;
+}
diff --git a/frontend/src/ui/Cockpit/styles/panels.css b/frontend/src/ui/Cockpit/styles/panels.css
new file mode 100644
index 0000000000000000000000000000000000000000..e76dd2bf7274374f275d143e94921b5716867159
--- /dev/null
+++ b/frontend/src/ui/Cockpit/styles/panels.css
@@ -0,0 +1,154 @@
+/* Right-mounted levers connect at their left end; reverse layout, not text. */
+.control-stalk[data-side="right"] {
+  flex-direction: row-reverse;
+  border-radius: 12px 28px 28px 12px;
+}
+.control-stalk[data-side="right"]::after {
+  left: -11%;
+  right: auto;
+}
+.control-stalk[data-side="right"] i {
+  right: 42%;
+  left: auto;
+}
+.turn-signal-lever {
+  display: grid;
+  grid-template-columns: 45px 76px;
+  grid-template-rows: 35px 35px;
+  justify-content: center;
+  gap: 6px 16px;
+}
+.turn-signal-lever button:first-child {
+  grid-column: 1;
+  grid-row: 1;
+}
+.turn-signal-lever button:last-child {
+  grid-column: 1;
+  grid-row: 2;
+}
+.turn-signal-lever .digital-wheel {
+  grid-column: 2;
+  grid-row: 1 / 3;
+  align-self: center;
+}
+/* The triangle itself is the border/face, centered in an independent HUD group.
+   The cockpit header deliberately has no second hazard switch. */
+.physical-hazard {
+  --contact-surface: transparent;
+  --contact-border: transparent;
+  --contact-ink: #ff8980;
+  clip-path: polygon(50% 0, 100% 100%, 0 100%);
+  display: grid;
+  place-items: center;
+  width: 36px;
+  height: 34px;
+  min-height: 0;
+  padding: 0 !important;
+  border: 0 !important;
+  background: transparent !important;
+  margin-inline: auto;
+}
+.physical-hazard > svg {
+  width: 100%;
+  height: 100%;
+  display: block;
+}
+.physical-hazard > svg > path:first-child {
+  fill: #471b22;
+  stroke-width: 1.6;
+}
+.physical-hazard[data-hud-held="true"] > svg > path:first-child {
+  fill: #813038;
+}
+/* Layout controls are grouped by feature rather than scattered around the HUD. */
+.research-hud-visibility,
+.parking-appearance {
+  border: 1px solid var(--app-line);
+  padding: 10px;
+  margin: 4px 0 14px;
+}
+.research-hud-visibility legend,
+.parking-appearance legend {
+  padding-inline: 6px;
+  font-size: 10px;
+}
+.research-hud-visibility p {
+  margin: 0 0 8px;
+  color: var(--app-muted);
+  font-size: 11px;
+}
+.research-hud-visibility > div {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
+  gap: 5px;
+}
+.research-hud-visibility button {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  text-align: left;
+}
+.parking-appearance > div,
+.climate-layout-choice {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 5px;
+  margin-bottom: 8px;
+}
+.parking-appearance {
+  margin-top: 14px;
+}
+.cockpit-climate-page {
+  width: min(100%, 420px);
+  margin: auto;
+}
+.climate-panel .climate-three-knobs {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  justify-items: center;
+}
+.climate-panel .climate-knob {
+  width: 100%;
+  max-width: 72px;
+}
+.drive-dock .climate-panel[data-size="compact"] .climate-knob {
+  width: 31px;
+}
+.drive-dock .climate-panel[data-size="full"] .climate-knob {
+  width: 100%;
+  max-width: 58px;
+}
+.cockpit-panel .climate-three-knobs .climate-knob > button {
+  min-height: 0;
+  font-size: 7px;
+}
+.cockpit-climate-page .climate-three-knobs {
+  gap: 14px;
+  padding-top: 22px;
+  padding-bottom: 16px;
+}
+.cockpit-climate-page .knob-title {
+  font-size: 8px;
+  top: -13px;
+}
+.cockpit-climate-page .climate-knob output {
+  font-size: 8px;
+  bottom: -12px;
+}
+
+/* Configuration choices show a small state marker, not a retained press glow. */
+:is(.climate-layout-choice, .parking-appearance)
+  button[aria-pressed="true"]::after {
+  content: "•";
+  color: var(--app-accent);
+  margin-left: 5px;
+}
+button.physical-hazard[data-hud-held="true"] {
+  background: transparent !important;
+  outline: 0 !important;
+}
+.physical-hazard:focus-visible > svg > path:first-child {
+  stroke: #fff;
+  stroke-width: 2;
+}
diff --git a/frontend/src/ui/Cockpit/styles/stalks.css b/frontend/src/ui/Cockpit/styles/stalks.css
new file mode 100644
index 0000000000000000000000000000000000000000..5553fa3798c1e54ba3f1d34054d85d5b8996d3eb
--- /dev/null
+++ b/frontend/src/ui/Cockpit/styles/stalks.css
@@ -0,0 +1,102 @@
+/* All three targets are positioned by stalks/geometry.ts. Avoid separate pixel
+   offsets here: changing one radius/angle must move the whole lever assembly. */
+.column-stalks {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  --contact-border: #58646e;
+  --contact-surface: #15202b;
+  --contact-ink: #dfe7e9;
+}
+.wheel-assembly > .column-stalks {
+  z-index: 1;
+}
+.stalk-actuator {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  transform-origin: 50% 50%;
+  transition: transform 100ms linear;
+}
+.column-stalk-rod {
+  position: absolute;
+  left: 50%;
+  top: 50%;
+  height: 3%;
+  transform-origin: 0 50%;
+  transform: translateY(-50%) rotate(var(--stalk-angle));
+  border: 1px solid #525a61;
+  border-radius: 4px;
+  background: linear-gradient(#484d53, #10171f 40%, #080c12 70%, #29333d);
+}
+.column-stalk-rod i {
+  position: absolute;
+  right: 3%;
+  top: 0;
+  bottom: 0;
+  width: 18%;
+  border-left: 2px solid #080a0f;
+  border-right: 1px solid #7c858e;
+  background: repeating-linear-gradient(90deg, #303941 0 1px, #11171e 1px 3px);
+}
+.wheel-assembly .column-stalk-cap {
+  position: absolute;
+  width: 8%;
+  height: 6.5%;
+  min-width: 0;
+  min-height: 0;
+  padding: 1px;
+  border: 1px solid;
+  border-radius: 5px;
+  transform: translate(-50%, -50%) rotate(var(--stalk-tangent));
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 0;
+  pointer-events: auto;
+  touch-action: none;
+  font: 4px/1 monospace;
+}
+.column-stalk-cap img {
+  width: 8px;
+  height: 7px;
+  object-fit: contain;
+  pointer-events: none;
+}
+.column-stalk-cap span {
+  font-size: 4px;
+}
+.wheel-assembly .stalk-step {
+  position: absolute;
+  width: 5.4%;
+  height: 6.5%;
+  min-width: 0;
+  min-height: 0;
+  padding: 0;
+  border: 1px solid transparent;
+  border-radius: 3px;
+  font: 4px/1 monospace;
+  white-space: nowrap;
+  pointer-events: auto;
+  touch-action: none;
+}
+.column-stalks button:disabled {
+  opacity: 0.35;
+}
+/* Hover/focus is not a held lever. Keyboard focus still has an underline. */
+.column-stalks button:is(:hover, :focus, :active) {
+  box-shadow: none;
+  outline: none;
+}
+.column-stalks button:focus-visible {
+  text-decoration: underline;
+}
+@media (prefers-reduced-motion: reduce) {
+  .stalk-actuator {
+    transition: none;
+  }
+}
+html[data-reduce-motion="true"] .stalk-actuator {
+  transition: none;
+}
diff --git a/frontend/src/ui/Cockpit/styles/switches.css b/frontend/src/ui/Cockpit/styles/switches.css
new file mode 100644
index 0000000000000000000000000000000000000000..6168bb9e2e746af76f37bd8ae570396966240adf
--- /dev/null
+++ b/frontend/src/ui/Cockpit/styles/switches.css
@@ -0,0 +1,34 @@
+/* Pedals and assist switches share contact feedback. The delegated owner clears
+   data-hud-held on release/cancel/blur/pause, even while the cursor stays here.
+   aria-pressed still exposes function state; it never selects a switch face. */
+.driving-pedals {
+  --switch-surface: #080e1680;
+  --switch-edge: #829bab61;
+  --switch-ink: #d9e5ee;
+  --switch-held-surface: #19323cbf;
+}
+.drive-assists {
+  --switch-surface: linear-gradient(165deg, #edf0f2, #a6adb5);
+  --switch-edge: #777f87;
+  --switch-ink: #080a0d;
+  --switch-held-surface: linear-gradient(165deg, #a8afb7, #d9dee3);
+}
+:is(.driving-pedals, .drive-assists) button {
+  --contact-surface: var(--switch-surface);
+  --contact-border: var(--switch-edge);
+  --contact-ink: var(--switch-ink);
+  border-radius: 1px;
+}
+:is(.driving-pedals, .drive-assists) button[data-hud-held="true"] {
+  border-color: var(--app-accent, #a7dbe9) !important;
+  background: var(--switch-held-surface) !important;
+  color: var(--switch-ink) !important;
+  outline: 1px solid var(--app-accent, #a7dbe9) !important;
+  outline-offset: -2px;
+}
+/* Black symbols stay readable on the silver FR-S-inspired assist faces in every
+   theme. Focus uses the common underline rather than a retained press border. */
+.drive-assists img {
+  filter: brightness(0);
+  opacity: 1;
+}
