+  border: 1px solid #698797aa;
+  border-radius: 50%;
+  background: #0a1821e8;
+  color: #c8e4ee;
+  cursor: pointer;
+  pointer-events: auto;
+}
+.map-toggle svg {
+  display: block;
+  width: 100%;
+  height: 100%;
+}
+.map-rim .match-clock {
