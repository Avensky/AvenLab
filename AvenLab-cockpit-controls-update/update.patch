@@ -0,0 +1,7 @@
+# Editor state and persistence
+
+layoutStore.ts owns authored document, selection, spawn edits, undo/redo and browser save. builderStore.ts owns the source/collision-template draft. builderActions.ts switches worlds with race protection and independent sessions. editorPreferences.ts owns local style/LOD/inspector visibility.
+
+## How to edit
+
+Commit document edits through layoutAction + layoutStore actions. Keep selection/cursor/view choices outside the saved map. Spawn edits use the same history as pieces. Preserve storage keys and per-world session ownership. Changing LOD/theme/sidebar never changes colliders or the running world.
diff --git a/frontend/src/worldBuilder/state/builderActions.ts b/frontend/src/worldBuilder/state/builderActions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..872de3ad3946cee603acc2b28cc5752757937d9c
--- /dev/null
+++ b/frontend/src/worldBuilder/state/builderActions.ts
@@ -0,0 +1,274 @@
+import { useInputStore } from "../../store/input/inputStore";
+import { useUIStore } from "../../store/menus/uiStore";
+import { leaveInspection } from "../../store/presentation/inspectionActions";
+import { useSelectionStore } from "../../store/selection/selectionStore";
+import { mapCatalog } from "../../store/selection/worldCatalog";
+import { useWorldStore, type MapSnapshot } from "../../store/world/worldStore";
+import { initialMapLayout } from "../document/layoutDocument";
+import {
+  editableBoxes,
+  mapExport,
+  parseMapText,
+  type MapDocument,
+} from "../document/mapDocument";
+import { sourceSpawns } from "../document/spawnDocument";
+import { builderStorageKey, useBuilderStore } from "./builderStore";
+import { useLayoutStore } from "./layoutStore";
+let request = 0;
+const bundledSources = new Map<string, MapDocument>();
+type LayoutSession = Pick<
+  ReturnType<typeof useLayoutStore.getState>,
+  | "doc"
+  | "saved"
+  | "past"
+  | "future"
+  | "selected"
+  | "cursor"
+  | "placementYaw"
+  | "focus"
+  | "selectedSpawn"
+>;
+const sessions = new Map<
+  string,
+  { source: MapDocument; layout: LayoutSession }
+>();
+// Offline previews supply the same real fixtures without replacing global fetch.
+export function configureBuilderMapSources(sources: MapDocument[]) {
+  bundledSources.clear();
+  for (const source of sources) bundledSources.set(source.map_id, source);
+}
+const editing = () => {
+  const ui = useUIStore.getState();
+  return ui.screen === "world_builder" || ui.overlay === "world_builder";
+};
+function rememberWorld() {
+  const source = useBuilderStore.getState().doc,
+    s = useLayoutStore.getState();
+  if (!source || s.doc?.map_id !== source.map_id) return;
+  window.dispatchEvent(
+    new Event("avenlab:cancel-authoring", { cancelable: true }),
+  );
+  if (s.doc !== s.saved) s.save();
+  const current = useLayoutStore.getState();
+  sessions.set(source.map_id, {
+    source,
+    layout: {
+      doc: current.doc,
+      saved: current.saved,
+      past: current.past,
+      future: current.future,
+      selected: current.selected,
+      cursor: current.cursor,
+      placementYaw: current.placementYaw,
+      focus: current.focus,
+      selectedSpawn: current.selectedSpawn,
+    },
+  });
+  const builder = useBuilderStore.getState();
+  if (builder.past.length && builder.doc !== builder.saved) builder.save();
+}
+async function readWorld(mapId: string) {
+  const embedded = bundledSources.get(mapId);
+  if (embedded) return embedded;
+  let text: string | null = null;
+  try {
+    text = localStorage.getItem(builderStorageKey(mapId));
+  } catch {
+    /* In-memory sessions still retain work. */
+  }
+  if (text) {
+    try {
+      return parseMapText(text, mapId);
+    } catch {
+      /* Load the bundled map if a saved source is corrupt. */
+    }
+  }
+  const response = await fetch(`/world-builder/${mapId}_colliders.json`);
+  if (!response.ok)
+    throw Error(
+      "Map source unavailable. Run the frontend build to refresh world definitions.",
+    );
+  return parseMapText(await response.text(), mapId);
+}
+export async function switchBuilderWorld(mapId: string) {
+  if (!editing()) return;
+  if (
+    !/^[a-zA-Z0-9_-]{1,96}$/.test(mapId) ||
+    (!mapCatalog.some((m) => m.id === mapId) &&
+      !bundledSources.has(mapId) &&
+      useBuilderStore.getState().doc?.map_id !== mapId)
+  )
+    throw Error("Unknown editor world");
+  const token = ++request;
+  if (useBuilderStore.getState().doc?.map_id === mapId) {
+    useBuilderStore.setState({ loadingMap: null });
+    return;
+  }
+  rememberWorld();
+  useBuilderStore.setState({ loadingMap: mapId, status: "Opening world…" });
+  useLayoutStore.setState({ placing: null, status: "Opening world…" });
+  try {
+    const session = sessions.get(mapId),
+      doc = session?.source ?? (await readWorld(mapId));
+    if (token !== request || !editing()) return;
+    rememberWorld();
+    useBuilderStore
+      .getState()
+      .load(
+        doc,
+        "World editor · " +
+          (mapCatalog.find((m) => m.id === mapId)?.name ?? mapId),
+      );
+    if (session)
+      useLayoutStore.setState({
+        ...session.layout,
+        placing: null,
+        reference: false,
+        cameraRevision: useLayoutStore.getState().cameraRevision + 1,
+        status: "World restored · local draft.",
+      });
+    else {
+      useLayoutStore
+        .getState()
+        .initialize(
+          doc.map_id,
+          initialMapLayout(doc.map_id, doc.authored_layout),
+          sourceSpawns(doc),
+        );
+      useLayoutStore.setState({
+        cursor: [0, doc.surface.road_y, 0],
+        focus: "layout",
+        status: "World ready · local draft.",
+      });
+    }
+  } catch (error) {
+    if (token === request) {
+      const status =
+        error instanceof Error ? error.message : "Could not open world";
+      useBuilderStore.setState({ status });
+      useLayoutStore.setState({ status });
+    }
+  } finally {
+    if (token === request) useBuilderStore.setState({ loadingMap: null });
+  }
+}
+export function compareLiveTemplate(doc: MapDocument, map: MapSnapshot) {
+  const chunk = map.chunks[0],
+    live =
+      chunk &&
+      map.collider_chunks?.find((c) => c.x === chunk.x && c.z === chunk.z);
+  if (!chunk || !live) return "Live collider comparison unavailable";
+  const boxes = editableBoxes(doc),
+    matches =
+      boxes.length === live.boxes.length &&
+      boxes.every((b) => {
+        const box = live.boxes.find((v) => v.id === b.id);
+        return (
+          box &&
+          b.center.every(
+            (v, i) => Math.abs(v + chunk.origin[i] - box.center[i]) < 0.002,
+          ) &&
+          b.half.every((v, i) => Math.abs(v - box.half_extents[i]) < 0.002)
+        );
+      });
+  return matches
+    ? "Source matches loaded collider template"
+    : "Source differs from server · Draft preview only";
+}
+export async function openWorldBuilder() {
+  const ui = useUIStore.getState(),
+    map = useWorldStore.getState().map;
+  if (ui.screen !== "sandbox" || ui.isModeLoading || !map) return;
+  const token = ++request;
+  leaveInspection();
+  useInputStore.getState().releaseControls();
+  ui.setOverlay("world_builder");
+  const state = useBuilderStore.getState();
+  if (state.doc?.map_id === map.map_id) return;
+  useBuilderStore.setState({ doc: null, status: "Loading map definition…" });
+  try {
+    let text: string | null = null;
+    try {
+      text = localStorage.getItem(builderStorageKey(map.map_id));
+    } catch {
+      /* Export remains available if storage is blocked. */
+    }
+    let doc: MapDocument | null = null;
+    if (text) {
+      try {
+        doc = parseMapText(text, map.map_id);
+      } catch {
+        /* A corrupt saved draft cannot block the bundled definition. */
+      }
+    }
+    const saved = doc !== null;
+    if (!doc) {
+      if (!/^[a-zA-Z0-9_-]{1,96}$/.test(map.map_id))
+        throw Error("Invalid map id");
+      const response = await fetch(
+        `/world-builder/${map.map_id}_colliders.json`,
+      );
+      if (!response.ok)
+        throw Error(
+          "Import the server map JSON to begin. Run the frontend build to refresh bundled definitions.",
+        );
+      doc = parseMapText(await response.text(), map.map_id);
+    }
+    if (
+      useBuilderStore.getState().doc ||
+      token !== request ||
+      useUIStore.getState().overlay !== "world_builder" ||
+      useWorldStore.getState().map?.map_id !== map.map_id
+    )
+      return;
+    state.load(
+      doc,
+      `${saved ? "Browser draft" : "Server source"} · ${compareLiveTemplate(doc, map)}`,
+      saved,
+    );
+  } catch (error) {
+    if (
+      !useBuilderStore.getState().doc &&
+      token === request &&
+      useUIStore.getState().overlay === "world_builder"
+    )
+      useBuilderStore.setState({
+        status:
+          error instanceof Error ? error.message : "Map definition unavailable",
+      });
+  }
+}
+export async function loadStandaloneBuilder() {
+  if (useBuilderStore.getState().loadingMap) return;
+  const mapId =
+    useBuilderStore.getState().doc?.map_id ??
+    useSelectionStore.getState().getSelectedMap?.()?.id ??
+    "streaming_endless_city";
+  await switchBuilderWorld(mapId);
+}
+export function closeWorldBuilder() {
+  request++;
+  rememberWorld();
+  const layout = useLayoutStore.getState();
+  if (layout.doc && layout.doc !== layout.saved) layout.save();
+  useInputStore.getState().releaseControls();
+  const ui = useUIStore.getState();
+  if (ui.screen === "world_builder") ui.setScreen("main");
+  else ui.setOverlay(ui.screen === "sandbox" ? "pause" : null);
+  useBuilderStore.setState({ workspace: "layout", loadingMap: null });
+}
+export function exportBuilderMap() {
+  const doc = useBuilderStore.getState().doc;
+  if (!doc) return;
+  const url = URL.createObjectURL(
+      new Blob([mapExport(doc)], { type: "application/json" }),
+    ),
+    a = document.createElement("a");
+  a.href = url;
+  a.download = `${doc.map_id}_colliders.json`;
+  a.click();
+  window.setTimeout(() => URL.revokeObjectURL(url), 0);
+  useBuilderStore.setState({
+    status: "Exported server map JSON · Install it and restart Rust to apply.",
+  });
+}
diff --git a/frontend/src/worldBuilder/state/builderStore.ts b/frontend/src/worldBuilder/state/builderStore.ts
new file mode 100644
index 0000000000000000000000000000000000000000..568d8a108442d486cae0c320d2757de0b85835aa
--- /dev/null
+++ b/frontend/src/worldBuilder/state/builderStore.ts
@@ -0,0 +1,201 @@
+import { create } from "zustand";
+import {
+  addBox,
+  editableBoxes,
+  editBox,
+  mapExport,
+  parseMapText,
+  planBounds,
+  removeBox,
+  type MapDocument,
+  type PlanBounds,
+  type Triple,
+} from "../document/mapDocument";
+type BuilderState = {
+  workspace: "layout" | "colliders";
+  doc: MapDocument | null;
+  saved: MapDocument | null;
+  past: MapDocument[];
+  future: MapDocument[];
+  selected: string | null;
+  bounds: PlanBounds | null;
+  loadingMap: string | null;
+  view: "plan" | "3d";
+  tool: "select" | "move";
+  preset: "iso" | "top";
+  zoom: number;
+  snap: number;
+  status: string;
+  source: string;
+  load: (doc: MapDocument, source: string, saved?: boolean) => void;
+  commit: (doc: MapDocument) => void;
+  select: (id: string | null) => void;
+  cycle: (direction: number) => void;
+  edit: (center: Triple, half: Triple) => void;
+  add: (kind: "road" | "building") => void;
+  remove: () => void;
+  undo: () => void;
+  redo: () => void;
+  save: () => void;
+  restore: () => void;
+  fit: () => void;
+};
+let storagePrefix = "avenlab-world-builder-v1";
+export const configurePreviewStorage = () => {
+  storagePrefix = "avenlab-world-builder-preview-v1";
+};
+export const builderStorageKey = (map: string) => `${storagePrefix}:${map}`;
+export const useBuilderStore = create<BuilderState>((set, get) => ({
+  workspace: "layout",
+  doc: null,
+  saved: null,
+  past: [],
+  future: [],
+  selected: null,
+  bounds: null,
+  loadingMap: null,
+  view: "plan",
+  tool: "select",
+  preset: "iso",
+  zoom: 1,
+  snap: 0.5,
+  status: "Loading map definition…",
+  source: "",
+  load: (doc, source, saved = false) =>
+    set({
+      doc,
+      saved: saved ? doc : null,
+      past: [],
+      future: [],
+      selected: editableBoxes(doc)[0]?.id ?? null,
+      bounds: planBounds(doc),
+      view: "plan",
+      tool: "select",
+      zoom: 1,
+      source,
+      status:
+        "LOCAL DRAFT · Edits affect the shared tile template, not the running server.",
+    }),
+  commit: (doc) => {
+    const s = get();
+    if (!s.doc) return;
+    set({
+      doc,
+      past: [...s.past, s.doc].slice(-32),
+      future: [],
+      selected: editableBoxes(doc).some((b) => b.id === s.selected)
+        ? s.selected
+        : (editableBoxes(doc)[0]?.id ?? null),
+      status:
+        "Unsaved draft · Export and restart the server to apply collisions.",
+    });
+  },
+  select: (selected) => set({ selected }),
+  cycle: (direction) => {
+    const s = get();
+    if (!s.doc) return;
+    const boxes = editableBoxes(s.doc);
+    if (!boxes.length) return;
+    const index = boxes.findIndex((b) => b.id === s.selected);
+    set({
+      selected: boxes[(index + direction + boxes.length) % boxes.length].id,
+    });
+  },
+  edit: (center, half) => {
+    const s = get();
+    if (s.doc && s.selected) s.commit(editBox(s.doc, s.selected, center, half));
+  },
+  add: (kind) => {
+    const s = get();
+    if (!s.doc) return;
+    const box = s.selected
+      ? editableBoxes(s.doc).find((b) => b.id === s.selected)
+      : null;
+    const doc = addBox(
+      s.doc,
+      kind,
+      box
+        ? [
+            box.center[0] + box.half[0] * 2 + 1,
+            s.doc.surface.road_y,
+            box.center[2],
+          ]
+        : undefined,
+    );
+    s.commit(doc);
+    set({
+      selected: editableBoxes(doc)
+        .filter((b) => b.kind === kind)
+        .at(-1)!.id,
+    });
+  },
+  remove: () => {
+    const s = get();
+    if (s.doc && s.selected) s.commit(removeBox(s.doc, s.selected));
+  },
+  undo: () => {
+    const s = get(),
+      doc = s.past.at(-1);
+    if (!doc || !s.doc) return;
+    set({
+      doc,
+      past: s.past.slice(0, -1),
+      future: [s.doc, ...s.future].slice(0, 32),
+      selected: editableBoxes(doc).some((b) => b.id === s.selected)
+        ? s.selected
+        : (editableBoxes(doc)[0]?.id ?? null),
+      status: "Undo · Draft only",
+    });
+  },
+  redo: () => {
+    const s = get(),
+      doc = s.future[0];
+    if (!doc || !s.doc) return;
+    set({
+      doc,
+      past: [...s.past, s.doc].slice(-32),
+      future: s.future.slice(1),
+      selected: editableBoxes(doc).some((b) => b.id === s.selected)
+        ? s.selected
+        : (editableBoxes(doc)[0]?.id ?? null),
+      status: "Redo · Draft only",
+    });
+  },
+  save: () => {
+    const s = get();
+    if (!s.doc) return;
+    try {
+      localStorage.setItem(builderStorageKey(s.doc.map_id), mapExport(s.doc));
+      set({
+        saved: s.doc,
+        status: "Saved in this browser · Export JSON to update the server.",
+      });
+    } catch {
+      set({
+        status: "Browser save unavailable. Export JSON to keep this draft.",
+      });
+    }
+  },
+  restore: () => {
+    const s = get();
+    if (!s.doc) return;
+    try {
+      const text = localStorage.getItem(builderStorageKey(s.doc.map_id));
+      if (!text) throw Error("No saved draft for this map");
+      s.commit(parseMapText(text, s.doc.map_id));
+      set({
+        saved: get().doc,
+        status: "Restored browser draft · Undo remains available.",
+      });
+    } catch (error) {
+      set({
+        status:
+          error instanceof Error ? error.message : "Could not restore draft",
+      });
+    }
+  },
+  fit: () => {
+    const s = get();
+    if (s.doc) set({ bounds: planBounds(s.doc), zoom: 1 });
+  },
+}));
