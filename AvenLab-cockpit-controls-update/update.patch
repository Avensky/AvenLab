-                "model": row.get("model"),
-            },
-            "bus_interface": row.get("bus_interface"),
-            "bus_mode": row.get("bus_mode"),
-            "capture_kind": capture_kind_for(row.get("bus_interface"), row.get("bus_mode")),
-            "source_label": source_label_for(row.get("bus_interface"), row.get("bus_mode")),
-            "completed": completed,
