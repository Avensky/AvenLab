+            snap(held.item.position[2] + p[1] - held.start[1], grid),
+          ]);
+          selection.current?.setAttribute(
+            "transform",
+            `translate(${held.next[0] - held.item.position[0]} ${held.next[2] - held.item.position[2]})`,
+          );
+        }
+      }}
+      onPointerUp={(e) => finish(e)}
+      onPointerCancel={(e) => finish(e, true)}
+      onLostPointerCapture={(e) => finish(e, true)}
+    >
+      <defs>
+        <pattern
+          id="layout-grid"
+          width="5"
+          height="5"
+          patternUnits="userSpaceOnUse"
+        >
+          <path
+            d="M5 0H0V5"
+            fill="none"
+            stroke={palette.grid}
+            strokeWidth=".12"
+          />
+        </pattern>
+      </defs>
+      <rect
+        x={view.x}
+        y={view.z}
+        width={view.width}
+        height={view.depth}
+        fill={palette.background}
+      />
+      <rect
+        x={view.x}
+        y={view.z}
+        width={view.width}
+        height={view.depth}
+        fill="url(#layout-grid)"
+      />
+      <path
+        d={`M${view.x} 0h${view.width}M0 ${view.z}v${view.depth}`}
+        stroke={palette.physical}
+        opacity=".3"
+        strokeWidth="1"
+        vectorEffect="non-scaling-stroke"
+      />
+      {preferences.chunkGuide && (
+        <g pointerEvents="none">
+          <rect
+            x="-100"
+            y="-100"
+            width="200"
+            height="200"
+            fill="none"
+            stroke={palette.accent}
+            strokeWidth="1.5"
+            strokeDasharray="4 3"
+            vectorEffect="non-scaling-stroke"
+          />
+          <path
+            d="M-100 0H100M0 -100V100"
+            fill="none"
+            stroke={palette.accent}
+            strokeWidth="1"
+            vectorEffect="non-scaling-stroke"
+          />
+          {(
+            [
+              [-98, -96, "NW"],
+              [2, -96, "NE"],
+              [-98, 6, "SW"],
+              [2, 6, "SE"],
+            ] as const
+          ).map(([x, z, label]) => (
+            <text key={label} x={x} y={z} fontSize="3" fill={palette.accent}>
+              {label} · 100 × 100 m
+            </text>
+          ))}
+        </g>
+      )}
+      {doc?.base === "overlay" && (
+        <g opacity=".45" pointerEvents="none">
+          {reference.map((b) => (
+            <rect
+              key={b.id}
+              x={b.center[0] - b.half[0]}
+              y={b.center[2] - b.half[2]}
+              width={b.half[0] * 2}
+              height={b.half[2] * 2}
+              fill={b.collection === "roads" ? "#26394d" : "#527897"}
+              stroke="#76a3c3"
+              strokeWidth=".5"
+              vectorEffect="non-scaling-stroke"
+            />
+          ))}
+        </g>
+      )}
+      {items
+        .filter((o) => o.id !== selected)
+        .map((item) => (
+          <PieceFootprint key={item.id} item={item} collisionOnly={wireframe} />
+        ))}
+      <g ref={selection}>
+        {items
+          .filter((o) => o.id === selected)
+          .map((item) => (
+            <g key={item.id}>
+              <PieceFootprint item={item} collisionOnly={wireframe} />
+              <polygon
+                points={pointsFor(item)}
+                fill="none"
+                stroke="#55caff"
+                strokeWidth="2"
+                vectorEffect="non-scaling-stroke"
+              />
+            </g>
+          ))}
+      </g>
+      {doc?.spawns?.map((point, i) => (
+        <g
+          key={point.id}
+          role="button"
+          aria-label={`${point.team} spawn ${i + 1}`}
+          transform={`translate(${point.position[0]} ${point.position[2]}) rotate(${-point.yaw})`}
+          onPointerDown={(e) => {
+            e.stopPropagation();
+            useLayoutStore.getState().selectSpawn(point.id);
+          }}
+        >
+          <circle
+            r="3"
+            fill={point.team === "red" ? "#ff687d" : "#78b3ff"}
+            fillOpacity={selectedSpawn === point.id ? 0.6 : 0.2}
+            stroke={point.team === "red" ? "#ff687d" : "#78b3ff"}
+            strokeWidth="1.5"
+            vectorEffect="non-scaling-stroke"
+          />
+          <path
+            d="M0 -2V3M-1 2l1 2 1-2"
+            fill="none"
+            stroke="white"
+            strokeWidth="1.5"
+            vectorEffect="non-scaling-stroke"
+          />
+        </g>
+      ))}
+      {phantom && (
+        <g
+          ref={ghost}
+          transform={`translate(${cursor[0]} ${cursor[2]})`}
+          pointerEvents="none"
+        >
+          <PieceFootprint item={phantom} ghost />
+        </g>
+      )}
+    </svg>
+  );
+}
